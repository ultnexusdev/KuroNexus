DATABASE_URL="postgresql://user:password@localhost:5432/kuronexus?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"
# Oturum cerezinin alan adi. Uretimde ".kuronexus.com" olmali (bastaki nokta
# sart): cerezi api.kuronexus.com yaziyor ama kuronexus.com'daki Next
# sunucusunun da okumasi gerekiyor. Lokalde iki taraf da localhost oldugu icin
# BOS birakilir.
AUTH_COOKIE_DOMAIN=

# Admin seed (prisma db seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"

# Server
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Uploads
UPLOAD_DIR="./uploads"
# Kod varsayilaniyla AYNI olmali (uploads.service.ts DEFAULT_MAX_BYTES).
MAX_UPLOAD_BYTES=10485760

# Transfermarkt Local Data Sync
TM_TEAM_ID=141
TM_SEASON=2024

# Kaggle API (transfermarkt-datasets indirmesi icin)
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key
KAGGLE_API_TOKEN=your-kaggle-access-token

# Apify (Turkiye Super Lig maclar + puan tablosu)
APIFY_TOKEN=your-apify-token
APIFY_TR_SEASON=2025

# TMDB (Salon 02 - Film arsivi). Anahtar YALNIZCA burada durur, frontend'e
# asla verilmez (kural 4). Anahtar yoksa film salonu bos acilir, cokmez.
# Hem v3 API key (32 karakter) hem v4 okuma jetonu (eyJ... ile baslayan JWT)
# kabul edilir; UltNexus'taki ayni deger buraya kopyalanabilir. Iki isim de
# okunur, TMDB_READ_ACCESS_TOKEN once gelir.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=your-tmdb-api-key
TMDB_LANGUAGE=tr-TR
# Saglayici rozetleri hangi ulkeye gore gosterilsin. Bos = TR.
TMDB_WATCH_REGION=TR

# Google Books (Salon 01 - Kitap kunyesi). Anahtar yoksa kunye
# zenginlestirme calismaz; salon yine acilir.
GOOGLE_BOOKS_API_KEY=

# Spotify (Salon 06 - Muzik). IKISI BIRDEN gerekli; biri eksikse esleme kapali.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Album kapaklarini yerele indir. "0" = indirme, disaridan sicak baglanti kalir.
MUSIC_ARTWORK_LOCALIZE=1

# Futbol canli veri (Salon 04). Kulup/lig profili:
FBL_SEASON=2025
FBL_CLUB_KEY=galatasaray
FBL_TFF_ENABLED=true
# Lig sampiyonlugu sayisi (rozet metni). Bos birakilirsa gosterilmez.
FBL_LEAGUE_TITLES=
# TheSportsDB. Anahtar verilmezse kod halka acik test anahtari '3' ile
# calisir; o anahtar siki limitlidir, uretimde kendi anahtarinizi verin.
TSDB_API_KEY=
# API-Football (yedek saglayici). Anahtar yoksa saglayici hic devreye girmez.
API_FOOTBALL_KEY=
API_FOOTBALL_TEAM_ID=645

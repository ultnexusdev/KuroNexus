// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  role              Role      @default(ADMIN)
  emailVerified     Boolean   @default(false)
  verificationToken String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  isDeleted         Boolean   @default(false)

  stories           Story[]
  wikiEntries       WikiEntry[]
  reviews           Review[]
  characterAnalyses CharacterAnalysis[]
  quotes            Quote[]
  comments          Comment[]
  favorites         Favorite[]
  movieEntries      MovieEntry[]
  movieDismissals   MovieSuggestionDismissal[]
  animeEntries      AnimeEntry[]
  showEntries       ShowEntry[]
  showDismissals    ShowSuggestionDismissal[]
  bookEntries       BookEntry[]
  readingGoals      ReadingGoal[]
  readingOrders     ReadingOrderProgress[]
}

model Story {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String    @db.Text
  excerpt     String?
  coverImage  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)

  // Yazım atölyesi: bir evren içindeki bölüm sırası (el yazması ağacı).
  // Yayın tarihi sıralaması kitap bölümleri için anlamsız — okuma sırası budur.
  orderIndex Int @default(0)

  // Faz 3: Community Stories desteği — admin içeriğiyle asla aynı listede karışmaz
  isCommunitySubmission Boolean          @default(false)
  submissionStatus      SubmissionStatus @default(APPROVED)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  universeId String?
  universe   WikiUniverse? @relation(fields: [universeId], references: [id])

  tags      TagOnStory[]
  comments  Comment[]
  favorites Favorite[]

  entryLinks StoryEntryLink[]

  @@index([userId])
  @@index([isPublished, isDeleted])
  @@index([submissionStatus])
  @@index([universeId])
  @@index([universeId, orderIndex])
}

model UniverseCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  universes   WikiUniverse[]
}

model WikiUniverse {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  categoryId  String?
  category    UniverseCategory? @relation(fields: [categoryId], references: [id])

  entries WikiEntry[]
  stories Story[]
  ambientTracks AmbientTrack[]
  sportPlayers    SportPlayer[]
  sportLegends    SportLegend[]
  raceEvents      RaceEvent[]
  driverStandings DriverStanding[]
  transferNews    TransferNews[]
  bookEntries     BookEntry[]
  /// Spor arşivi köprüsü (Salon 06). Sanal ters-ilişki: FK sütunu karşı tarafta
  /// (FootballClub.universeId). Bu satır tek başına SIFIR SQL üretir.
  footballClubs   FootballClub[]

  // Kural 14: FK'lere Prisma otomatik index koymuyor.
  // Bu index üretimde ZATEN VAR (migration geçmişinden geliyor) ama şemada
  // bildirilmemişti — 8 Ağustos 2026'da yerel veritabanı kurulup sürüklenme
  // ölçüldüğünde bulundu. Bildirilmemiş olmasının bedeli sessizdi ve büyüktü:
  // `prisma migrate dev` çalıştıran biri, üretimde çalışan bu indexi DÜŞÜREN
  // bir migration üretirdi. Satır burada olduğu için artık üretmez; üretime
  // uygulandığında da hiçbir DDL çıkmaz (index zaten yerinde).
  @@index([categoryId])
}

// Dış API yanıtları için kalıcı cache (kural 4 + 14: her sayfa yüklemesinde
// dış istek atılmaz; fetchedAt ile TTL uygulanır, hata durumunda bayat veri
// sunulur ama kullanıcıya hata gösterilmez)
model ExternalCache {
  cacheKey  String   @id
  payload   Json
  fetchedAt DateTime @default(now())
}

// ---- Spor kanadı (Faz A: veriler admin panelden girilir, kural 4'e uygun
// dış API entegrasyonu Faz B'de bu modellerin üstüne eklenecek) ----

model SportPlayer {
  id          String  @id @default(cuid())
  name        String
  shirtNumber Int?
  position    String // GK / DF / MF / FW vb. — çeviri anahtarı olarak kullanılır
  nationality String?
  imageUrl    String?
  appearances Int     @default(0)
  goals       Int     @default(0)
  assists     Int     @default(0)
  note        String? @db.Text
  order       Int     @default(0)

  universeId String
  universe   WikiUniverse @relation(fields: [universeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([universeId, isDeleted])
}

model SportLegend {
  id           String  @id @default(cuid())
  name         String
  era          String? // örn. "1996–2001"
  title        String? // örn. "Karpatların Maradonası"
  story        String  @db.Text
  imageUrl     String?
  achievements String? @db.Text // satır satır başarı listesi
  order        Int     @default(0)

  universeId String
  universe   WikiUniverse @relation(fields: [universeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([universeId, isDeleted])
}

model RaceEvent {
  id           String    @id @default(cuid())
  round        Int
  name         String // örn. "Türkiye GP"
  circuit      String // örn. "Istanbul Park"
  country      String?
  raceDate     DateTime?
  trackSvgPath String?   @db.Text // pistin tek çizgi SVG path verisi (d attribute)

  universeId String
  universe   WikiUniverse @relation(fields: [universeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([universeId, isDeleted])
}

model DriverStanding {
  id       String  @id @default(cuid())
  position Int
  driver   String
  team     String?
  points   Int     @default(0)
  wins     Int     @default(0)
  teamColor String? // takımın gerçek dünya rengi — veri, tema token'ı değil

  universeId String
  universe   WikiUniverse @relation(fields: [universeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([universeId, isDeleted])
}

model WikiEntry {
  id          String       @id @default(cuid())
  title       String
  slug        String
  content     String       @db.Text
  category    WikiCategory
  coverImage  String?
  metadata    Json?
  spoilerTier Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  isDeleted   Boolean      @default(false)

  // Takma adlar: el yazmasında "Kağan" yazınca "Temür Kağan" kaydı bulunsun.
  // Yalnızca metin taraması/öneri içindir, ilişki kaynağı DEĞİLDİR (kural 5).
  aliases String[] @default([])

  universeId String
  universe   WikiUniverse @relation(fields: [universeId], references: [id])
  userId     String
  user       User         @relation(fields: [userId], references: [id])

  tags              TagOnWikiEntry[]
  comments          Comment[]
  favorites         Favorite[]
  characterAnalyses CharacterAnalysis[]

  // Çapraz linkleme (AGENTS.md kural 5): karakter → terim → şehir ilişkileri
  outgoingRelations WikiEntryRelation[] @relation("outgoing")
  incomingRelations WikiEntryRelation[] @relation("incoming")

  storyLinks StoryEntryLink[]

  @@unique([universeId, slug])
  @@index([userId])
  @@index([universeId, category, isDeleted])
}

// Wiki sayfaları arası ilişkiler veri modelinde tutulur — düz metin linki DEĞİL.
model WikiEntryRelation {
  fromId       String
  from         WikiEntry @relation("outgoing", fields: [fromId], references: [id])
  toId         String
  to           WikiEntry @relation("incoming", fields: [toId], references: [id])
  relationType String?
  createdAt    DateTime  @default(now())

  @@id([fromId, toId])
  @@index([toId])
}

// Bölüm ↔ wiki kaydı bağı. Metindeki mention işareti yalnızca gösterimdir;
// sorgulanabilir ilişki burada tutulur (AGENTS.md kural 5). Kayıt sırasında
// bölüm içeriğinden türetilir, elle beslenmez.
model StoryEntryLink {
  storyId   String
  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  entryId   String
  entry     WikiEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([storyId, entryId])
  @@index([entryId])
}

// Film arşivi: kişisel koleksiyon takibi. Review'un yerine geçmez — Review
// uzun yazılmış inceleme, bu ise "izledim / sırada / tekrar izlerim + puanım".
// TMDB verisi `externalData` içinde anlık görüntü olarak durur (kural 4):
// dış kaynak değişse bile kişisel puan/not etkilenmez.
model MovieEntry {
  id                    String      @id @default(cuid())
  tmdbId                Int
  status                MovieStatus @default(WATCHED)
  isFavorite            Boolean     @default(false)
  personalRating        Float?
  personalNote          String?     @db.Text
  watchedAt             DateTime?
  externalData          Json?
  externalDataFetchedAt DateTime?
  /// Elle girilen dış bağlantılar: { rt, imdb, trailer }. Rotten Tomatoes'un
  /// ne API'si ne de TMDB'de karşılığı var — kart varsayılan olarak arama
  /// adresine gider, doğru adres buraya yazılınca onu kullanır.
  links                 Json?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  isDeleted             Boolean     @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Aynı film arşive iki kez girmez
  @@unique([userId, tmdbId])
  @@index([userId, status, isDeleted])
  @@index([userId, isFavorite, isDeleted])
}

/// Anime arşivinde **benim** durumum. Yapımın kendi yayın durumu (devam
/// ediyor / tamamlandı / yakında) buradan okunmaz — o AniList'ten gelir ve
/// türetilir. İki eksen bilinçli olarak ayrı: "bitirdim ama yeni sezon yolda"
/// ancak böyle anlatılabiliyor.
enum AnimeWatchStatus {
  WATCHING
  COMPLETED
  PLANNED
  ON_HOLD
  DROPPED
  REWATCHING
}

/// Anime arşivinde bir **seri** (franchise). Sezonlar, filmler ve OVA'lar
/// altındaki `AnimePart` kayıtlarıdır — rafta tek kart görünsün diye.
model AnimeEntry {
  id                    String           @id @default(cuid())
  /// Serinin kök yapımı (genelde 1. sezon) — AniList Media id'si
  anilistId             Int
  malId                 Int?
  status                AnimeWatchStatus @default(WATCHING)
  isFavorite            Boolean          @default(false)
  personalRating        Float?
  personalNote          String?          @db.Text
  startedAt             DateTime?
  finishedAt            DateTime?
  /// Kök yapımın AniList künyesi (başlık, kapak, banner, tür, etiket, manga bağı)
  externalData          Json?
  externalDataFetchedAt DateTime?
  /// Küratörün seçtiği sabit banner. Doluysa AniList'ten gelene bakılmaz —
  /// künye her tazelendiğinde sayfanın üstü değişmesin diye (kullanıcı kararı).
  bannerImage           String?
  /// Elle girilen dış bağlantılar: { manga, opening, ending, trailer, official }.
  /// Hiçbir API vermediği (manga okuma adresi, OP/ED klibi) ya da yanlış
  /// verdiği bağlantılar burada durur; AniList'ten geleni ezer.
  links                 Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  isDeleted             Boolean          @default(false)

  userId String
  user   User        @relation(fields: [userId], references: [id])
  parts  AnimePart[]

  // Aynı seri arşive iki kez girmez
  @@unique([userId, anilistId])
  @@index([userId, status, isDeleted])
  @@index([userId, isFavorite, isDeleted])
}

/// Serinin bir parçası: sezon, film, OVA ya da özel bölüm. İlerleme **burada**
/// tutulur (serinin ilerlemesi bunlardan türetilir) — iki ayrı sayı tutulursa
/// birbirini tutmaz.
model AnimePart {
  id              String  @id @default(cuid())
  anilistId       Int
  malId           Int?
  /// İzleme sırası: yayın tarihine göre kurulur, elle düzeltilebilir
  orderIndex      Int     @default(0)
  watchedEpisodes Int     @default(0)
  isCompleted     Boolean @default(false)
  personalRating  Float?

  /// Faz B — bölüm bölüm işaretleme: { "12": "WATCHED" | "SKIPPED" }.
  /// Sayaç günlük kullanım için yeterli; bu alan sırayı bozup atlanan
  /// bölümleri anlatabilmek için var.
  episodeMarks Json?

  /// Faz B — manga bağı: bu parçanın bittiği manga bölümü. Hiçbir API bu
  /// eşlemeyi vermiyor, elle girilir ("S2 sonu = manga 137").
  mangaChapter Int?

  externalData          Json?
  externalDataFetchedAt DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  entryId String
  entry   AnimeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, anilistId])
  @@index([entryId, orderIndex])
}

/// Öneri rafında "ilgilenmiyorum" denen filmler. Arşive girmedikleri için
/// MovieEntry'de yerleri yok; ayrı tutulmalarının sebebi bu. Yalnızca öneri
/// havuzunu süzer — elenen film arama ile her zaman eklenebilir.
model MovieSuggestionDismissal {
  id        String   @id @default(cuid())
  tmdbId    Int
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, tmdbId])
}

// Dizi arşivi: film arşivinin bire bir aynısı, kaynağı yalnızca TMDB'nin
// dizi (tv) uçları. Anime dizileri buraya girmez — Salon 04 · Anime kendi
// arşivine sahip; TMDB tarafında "Animation" türü + Japonya kökeni taşıyan
// sonuçlar arama/keşif katmanında elenir (bkz. tmdb-tv.service.ts).
model ShowEntry {
  id                    String      @id @default(cuid())
  tmdbId                Int
  status                ShowStatus  @default(WATCHED)
  isFavorite            Boolean     @default(false)
  personalRating        Float?
  personalNote          String?     @db.Text
  watchedAt             DateTime?
  externalData          Json?
  externalDataFetchedAt DateTime?
  /// Elle girilen dış bağlantılar: { rt, imdb, trailer } — film arşivindeki
  /// aynı mantık (bkz. MovieEntry.links).
  links                 Json?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  isDeleted             Boolean     @default(false)

  userId String
  user   User        @relation(fields: [userId], references: [id])
  seasons ShowSeason[]

  // Aynı dizi arşive iki kez girmez
  @@unique([userId, tmdbId])
  @@index([userId, status, isDeleted])
  @@index([userId, isFavorite, isDeleted])
}

/// Bir dizinin sezonu — anime kanadındaki `AnimePart`ın karşılığı. İlerleme
/// **burada** tutulur (dizinin ilerlemesi sezonlardan türetilir); iki ayrı
/// sayı tutulursa birbirini tutmaz.
///
/// Animeden bir fark var: sezon listesi elle kurulmaz, TMDB künyesiyle
/// birlikte zaten geliyor — dizi arşive eklenince sezonlar kendiliğinden
/// oluşur, künye tazelenince yeni sezonlar eklenir (ilerleme korunur).
/// Özel bölümler (TMDB'de sezon 0) alınmaz: ana akışın sayacını bozuyor.
model ShowSeason {
  id              String  @id @default(cuid())
  /// TMDB sezon numarası (1'den başlar); sıralama da buna göre
  seasonNumber    Int
  orderIndex      Int     @default(0)
  watchedEpisodes Int     @default(0)
  isCompleted     Boolean @default(false)
  personalRating  Float?

  /// Bölüm bölüm işaretleme: { "12": "SKIPPED" }. Sayaç günlük kullanım için
  /// yeterli; bu alan atlanan bölümleri anlatabilmek için var (anime kanadıyla
  /// aynı desen).
  episodeMarks Json?

  /// TMDB sezon künyesi anlık görüntüsü: ad, bölüm sayısı, yayın tarihi, afiş
  externalData          Json?
  externalDataFetchedAt DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  entryId String
  entry   ShowEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, seasonNumber])
  @@index([entryId, orderIndex])
}

model ShowSuggestionDismissal {
  id        String   @id @default(cuid())
  tmdbId    Int
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, tmdbId])
}

/// Salon 05 · Kitap arşivi.
///
/// Film/dizi/anime kanatlarından **bilinçli olarak ayrılan** bir yanı var:
/// orada künye tamamen dış kaynağın anlık görüntüsünden (`externalData`)
/// okunur, burada okunmaz. Kullanıcı kararı: "Google Books sadece ilk veriyi
/// doldursun, sonrasını kendi tablona ekle." Bu yüzden gösterilen bütün
/// alanlar (ad, yazar, çevirmen, yayıncı, sayfa) **kendi sütunlarımız**;
/// Google Books yalnızca kayıt açılırken bunları tohumlar. Künye tazeleme
/// yalnızca BOŞ alanları doldurur, dolu olanı asla ezmez.
///
/// Sebebi kitaba özgü: Google Books'un Türkçe künyesi eksik ve tutarsız
/// (çevirmen çoğu baskıda hiç yok, sayfa sayısı baskıya göre değişiyor),
/// oysa arşivin kendisi Türkçe okunacak.
model BookEntry {
  id String @id @default(cuid())

  /// Google Books cilt numarası — kaydın kaynağı. Open Library'den açılan
  /// kitapta boş kalır.
  googleId String?
  /// Open Library work/edition anahtarı ("/works/OL27448W"). Google Books'un
  /// bilmediği (özellikle çevrilmemiş ya da eski) kitaplar buradan gelir.
  olKey    String?
  /// 1000Kitap sayfa anahtarı ("bulbulu-oldurmek--939"). Tekrar ekleme
  /// kontrolünün en kesin adımı; Faz 1'de yalnızca `externalData` içinde
  /// duruyordu, sorgulanabilir olması için sütuna alındı.
  binKitapSlug String?
  isbn13   String?

  // --- Künye: ilk veriyi dış kaynak doldurur, sonrası küratörün ---
  /// Gösterilen ad. Türkçesi varsa Türkçe (kullanıcı kararı).
  title              String
  /// Orijinal dildeki ad — çevrilmiş kitapta ikinci satır olarak görünür
  originalTitle      String?
  authors            String[]
  /// Çeviri kitapta künyenin en çok aranan satırı; hiçbir API güvenilir vermiyor
  translator         String?
  publisher          String?
  /// Elimdeki baskının yılı
  publishedYear      Int?
  /// Eserin ilk yayımlandığı yıl (Open Library `first_publish_year`) — baskı
  /// yılıyla karıştırılmaz: "1954'te yazıldı, 2019 baskısını okudum"
  firstPublishedYear Int?
  pageCount          Int?
  /// Okuduğum baskının dili ("tr" / "en") — çeviri durumundan ayrı bir bilgi
  language           String?
  coverImage         String?
  description        String?  @db.Text
  /// Tür bilgisinin **düz metin** hâli. Faz 2a'da ilişkisel `BookGenre`
  /// eklendi ve gerçek kaynak o oldu; bu sütun geçiş boyunca okunmaya devam
  /// ediyor, Faz 2b'de düşecek.
  genres             String[]

  /// Serinin adı — düz metin hâli. `seriesId` ilişkisi geldiği için artık
  /// yedek; Faz 2b'de düşecek. Cilt sırası (`seriesIndex`) ilişkiye taşınMAZ:
  /// o seriye değil, kitabın seri içindeki yerine ait bir bilgi.
  seriesName  String?
  seriesIndex Int?

  // --- Faz 2a: ilişkisel künye (Kural 11) ---
  // Düz metin sütunları geçiş boyunca korunuyor; yazma yolu ikisini birden
  // dolduruyor, okuma yolu Faz 2b'de ilişkilere geçecek.

  /// Yazar, çevirmen ve editör — rol join üstünden (bkz. `BookPersonRole`).
  people BookPersonOnEntry[]

  /// Türler; kaynağın verdiği ama süzgeçte karşılığı olmayanlar
  /// `BookGenre.isApproved = false` ile bekler (kullanıcı kararı: otomatik
  /// tür üretilmesin, önerilsin).
  genreLinks BookGenreOnEntry[]

  /// İlişki alanı geçici olarak `publisherRef` adında: düz metin `publisher`
  /// sütunu Faz 2b'de düşene kadar ad çakışıyor. 2b'de skaler kalkınca bu
  /// alan `publisher` olarak yeniden adlandırılacak.
  publisherId  String?
  publisherRef BookPublisher? @relation(fields: [publisherId], references: [id])

  seriesId String?
  series   BookSeries? @relation(fields: [seriesId], references: [id])

  status           BookStatus      @default(READ)
  /// "5 kitaplık seri, 3'ü Türkçe" bilgisinin kaynağı. Çevrilmemiş cilt de
  /// arşivde durur (seri eksik görünmesin) ama okuma sayılarına girmez.
  translationState BookTranslation @default(TRANSLATED)
  isFavorite       Boolean         @default(false)
  personalRating   Float?
  personalNote     String?         @db.Text
  startedAt        DateTime?
  finishedAt       DateTime?

  /// Okuma ilerlemesi — "şu an okuyorum" rafındaki kitabın kaldığı sayfa.
  /// Animedeki bölüm sayacının kitap karşılığı; yüzde bundan ve `pageCount`tan
  /// türetilir, ayrıca tutulmaz (iki sayı birbirini tutmuyor).
  currentPage Int @default(0)

  /// Elle girilen dış bağlantılar: { goodreads, dr, idefix, official }.
  /// Film/dizi kanadındaki `links` ile aynı mantık.
  links Json?

  /// Dış kaynağın ham anlık görüntüsü. Gösterimde kullanılmaz — sütunlar
  /// tohumlanırken ve "başka baskılar" listesinde okunur (kural 4/14).
  externalData          Json?
  externalDataFetchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// Kadim Dünyalar bağı: seri bir evrene bağlıysa kitap sayfasından o evrene
  /// geçilir (kullanıcı isteği: "tıklayınca evren sayfasına atsın")
  universeId String?
  universe   WikiUniverse? @relation(fields: [universeId], references: [id])

  quotes BookQuote[]

  // Aynı kitap arşive iki kez girmesin. Google numarası olmayan kayıtlarda
  // (Open Library'den gelenler) bu kısıt boşa düşer; servis ayrıca olKey ve
  // ISBN üstünden de kontrol ediyor.
  @@unique([userId, googleId])
  @@index([userId, status, isDeleted])
  @@index([userId, isFavorite, isDeleted])
  @@index([userId, seriesName, isDeleted])
  @@index([universeId])
  // Kural 14: foreign key'lere Prisma otomatik index koymuyor
  @@index([publisherId])
  @@index([seriesId, seriesIndex])
}

// ---- Faz 2a: kitap künyesinin ilişkisel modeli (Kural 11) ----
//
// Neden düz metin sütunlarından buraya geçiliyor: yazar/yayınevi/çevirmen
// artık **kendi verisini** taşıyor (biyografi, fotoğraf, logo, site). Şemada
// daha önce "seri kaydının kendi başına taşıyacağı veri yok" diye ilişkiye
// gerek görülmemişti; bu gerekçe kullanıcının yeni isteğiyle geçersizleşti.
//
// Eşleştirme anahtarı: kaynağın verdiği kimlik varsa O, yoksa aksan katlanmış
// ad (`slug`). Ölçüldü — 1000Kitap kişiye ve türe kimlik veriyor
// (`yazarlar[].id`, `kidDizi[].id`), yayınevi ve seri ise düz metin.

/// Yazar / çevirmen / editör. Rol bu tabloda değil, `BookPersonOnEntry`de.
model BookPerson {
  id   String @id @default(cuid())
  name String
  /// Aksan katlanmış eşleştirme anahtarı: "Ülker İnce" ile "ULKER INCE" ya da
  /// "ulker ince" aynı kişi sayılsın diye. Kaynak kimliği yoksa tek dayanak.
  slug String @unique

  /// 1000Kitap kişi kimliği — **en güvenilir eşleştirme anahtarı**.
  /// Ad üstünden eşleştirme kırılgan: "Steven Erikson" / "Erikson, Steven" /
  /// "STEVEN ERIKSON" üç ayrı kişi sanılırdı.
  binKitapId String? @unique

  /// Kaynağın kendi adres anahtarı (`yazarlar[].seo_adi`, "harper-lee").
  ///
  /// `slug`tan ayrı tutuluyor çünkü **yazar sayfası yalnızca bu biçimle
  /// açılıyor** (ölçüldü): `/yazar/harper-lee` çalışıyor; `/yazar/harper-lee--566`
  /// ve `/yazar/566` ise **200 dönüp boş sayfa** veriyor — yalnızca durum
  /// koduna bakan bir doğrulama bunu "çalışıyor" sanır. Kendi slug'umuz çoğu
  /// adda aynı çıkıyor ama eşit olduklarını varsaymak biyografiyi sessizce
  /// kaybettirirdi.
  binKitapSeoName String?

  /// Kaynak fotoğrafı da veriyor (`yazarlar[].resim`); indirilip
  /// `/uploads/books/…` olarak saklanır (hotlink yok).
  photo     String?
  biography String? @db.Text

  entries BookPersonOnEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookPersonOnEntry {
  personId String
  person   BookPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  entryId  String
  entry    BookEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  role     BookPersonRole
  /// Künyede görünme sırası — çok yazarlı kitapta ilk yazar başta kalsın
  orderIndex Int @default(0)

  /// Aynı kişi aynı kitapta hem yazar hem çevirmen olabilir; kısıt role dahil
  @@id([entryId, personId, role])
  @@index([personId])
  @@index([entryId, role, orderIndex])
}

/// Yayınevi. Kaynak kimlik vermiyor (`yayinevi` düz metin, ölçüldü) —
/// eşleştirme yalnızca `slug` üstünden.
model BookPublisher {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  logo    String?
  website String?

  books BookEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Seri. Cilt sırası burada DEĞİL, `BookEntry.seriesIndex`te: sıra seriye
/// değil kitabın seri içindeki yerine ait.
model BookSeries {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  coverImage  String?

  books BookEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Tür. Süzgeç bunun üstünden çalışacak.
model BookGenre {
  id   String @id @default(cuid())
  name String
  slug String @unique

  /// Ön yüzdeki sabit tür listesinin anahtarı ("scifi", "fantasy"…). Çeviri
  /// bu anahtardan okunuyor; kaynaktan gelip listede karşılığı olmayan türde
  /// boş kalır.
  key String? @unique

  /// 1000Kitap tür kimliği (`kidDizi[].id`) — ad değişse de eşleşme tutsun
  binKitapId String? @unique

  /// **Kullanıcı kararı: kaynaktan gelen tür otomatik kabul edilmez.**
  /// Eşleşmeyen tür `false` ile açılır, süzgeçte görünmez ve admin panelde
  /// "eşleşmeyen türler" olarak onay bekler. Otomatik kabul edilseydi tür
  /// listesi aynı kavramın varyantlarıyla dolardı (Roman / Fantastik Roman).
  isApproved Boolean @default(false)

  entries BookGenreOnEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isApproved])
}

model BookGenreOnEntry {
  genreId String
  genre   BookGenre @relation(fields: [genreId], references: [id], onDelete: Cascade)
  entryId String
  entry   BookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([entryId, genreId])
  @@index([genreId])
}

/// Altını çizdiğim satır. Sayfa numarası ve bağlam elle girilir — hiçbir API
/// vermiyor, zaten kişisel içerik (kural 4: dış veriden ayrı model).
model BookQuote {
  id         String  @id @default(cuid())
  text       String  @db.Text
  /// Alıntının geçtiği sayfa; baskıya göre değişebildiği için zorunlu değil
  page       Int?
  /// "Kim, nerede söyledi" — alıntıyı yalnız bırakmayan tek satır
  context    String?
  isFavorite Boolean @default(false)
  orderIndex Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  entryId String
  entry   BookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, isDeleted, orderIndex])
}

/// Yıllık okuma hedefi ("2026'da 40 kitap"). Yıl başına tek kayıt; geçmiş
/// yıllar silinmiyor — hedefin tutup tutmadığı da bir okuma günlüğü.
model ReadingGoal {
  id          String @id @default(cuid())
  year        Int
  targetBooks Int
  /// Sayfa hedefi isteğe bağlı: kimi yıl "40 kitap", kimi yıl "12.000 sayfa"
  targetPages Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, year])
}

/// Okuma sırasında nerede kaldığım ("buradayım" imi).
///
/// Sıranın kendisi kodda (`data/reading-orders.data.ts`); burada yalnızca imin
/// yeri duruyor. Sıra başına tek kayıt — im bir konum, bir günlük değil.
model ReadingOrderProgress {
  id String @id @default(cuid())

  /// Okuma sırasının anahtarı ("vakif")
  orderKey String
  /// Kaçıncı duraktayım. 0 = im kaldırıldı (kayıt silmek yerine sıfırlanıyor)
  currentOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, orderKey])
}

model Review {
  id                     String    @id @default(cuid())
  title                  String
  slug                   String    @unique
  content                String    @db.Text
  rating                 Float?
  mediaType              MediaType
  externalId             String?
  externalData           Json?
  externalDataFetchedAt  DateTime?
  coverImage             String?
  isPublished            Boolean   @default(false)
  publishedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  isDeleted              Boolean   @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tags              TagOnReview[]
  comments          Comment[]
  favorites         Favorite[]
  characterAnalyses CharacterAnalysis[]

  @@index([userId])
  @@index([mediaType, isPublished, isDeleted])
}

// Karakter analizi, Review (anime/film) veya WikiEntry (kitap karakteri) üzerinden
// tetiklenebilir — ikisi de opsiyonel, hangi kaynaktan geldiği karışmaz.
model CharacterAnalysis {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  content     String   @db.Text
  series      String
  coverImage  String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  reviewId    String?
  review      Review?    @relation(fields: [reviewId], references: [id])
  wikiEntryId String?
  wikiEntry   WikiEntry? @relation(fields: [wikiEntryId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tags TagOnCharacterAnalysis[]

  @@index([userId])
  @@index([reviewId])
  @@index([wikiEntryId])
}

model Quote {
  id        String   @id @default(cuid())
  text      String   @db.Text
  source    String
  character String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tags TagOnQuote[]

  @@index([userId])
}

// --- Dosya/Görsel Yükleme (Faz 1) ---
// Kapak görselleri, wiki harita dosyaları, mood board görselleri buradan yönetilir.
// Dosyalar Coolify persistent volume'e yazılır (/app/uploads), DB yalnızca metadata tutar.
model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  altText      String?
  createdAt    DateTime @default(now())
  isDeleted    Boolean  @default(false)

  userId String

  @@index([userId])
}

/// Karakter sayfasındaki elle yüklenen görseller.
///
/// Neden ayrı tablo: karakter sayfalarının yazılı içeriği (Shikai/Bankai
/// açıklamaları, replikler, güç profili) bilinçli olarak **kodda** duruyor —
/// her sayfa kendine özel tasarlandığı için esnek bölüm tiplerini bir forma
/// sığdırmak tasarımı forma feda etmek olurdu (kullanıcı kararı, 6 Ağustos
/// 2026). Ama GÖRSELLER için aynı şey geçerli değil: kürator bir görsel
/// yükleyip anında sayfada görmek istiyor, her seferinde bir geliştiriciye
/// adres iletmek istemiyor. O yüzden yalnızca görseller veritabanında.
///
/// `characterId` bir foreign key DEĞİL, AniList karakter numarası: karakterler
/// bizim veritabanımızda durmuyor, AniList'ten cache üzerinden geliyor
/// (bkz. `anilist.service.ts`). Sayfa adresi de bu numara.
model CharacterImage {
  id          String             @id @default(cuid())
  /// AniList karakter numarası — sayfanın adresi
  characterId Int
  slot        CharacterImageSlot @default(GALLERY)
  /// Yalnızca `ABILITY` yuvasında dolu: hangi yetenek kartına ait
  /// ("Shikai — Nozarashi", "Bankai"). Kart adı koddaki katmandan geliyor.
  abilityName String?
  /// Kendi sunucumuzdaki yol (`/uploads/…`). Dış adres saklanmıyor:
  /// CSP yabancı sunucuya izin vermiyor ve dış adres bir gün ölebilir.
  url         String
  altText     String?
  caption     String?
  /// Galeride sıralama; küçük olan önce
  orderIndex  Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  /// Kural 3: fiziksel silme yok
  isDeleted   Boolean            @default(false)

  userId String

  @@index([characterId, slot, isDeleted])
  @@index([userId])
}

/// Karakter dizininden çıkarılan karakterler.
///
/// Dizin, arşivdeki serilerin AniList kadrolarından **türetiliyor** — yani
/// bir karakteri "silmek" diye bir şey yok, kaynak onu her tazelemede geri
/// getirir. Kalıcı olan tek şey bizim dışlama listemiz; bu tablo o.
///
/// ⚠️ Burada yumuşak silme YOK (AGENTS.md kural 3'ün istisnası, bilinçli):
/// kayıt zaten "gösterme" demek. Geri almak = kaydı silmek. `isDeleted`
/// eklemek "gizlemeyi gizlemek" gibi anlamsız bir ikinci katman olurdu.
model HiddenCharacter {
  id          String   @id @default(cuid())
  /// AniList karakter numarası
  characterId Int      @unique
  createdAt   DateTime @default(now())

  userId String

  @@index([userId])
}

enum CharacterImageSlot {
  /// Künye levhasındaki büyük portre — tek kayıt beklenir, sonuncusu kazanır
  PORTRAIT
  /// Galeri ızgarası — çok kayıt
  GALLERY
  /// Bir yetenek kartının görseli (`abilityName` ile eşleşir)
  ABILITY
}

// --- Etiket Sistemi (ilişkisel, String[] DEĞİL) ---
model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  stories           TagOnStory[]
  wikiEntries       TagOnWikiEntry[]
  reviews           TagOnReview[]
  characterAnalyses TagOnCharacterAnalysis[]
  quotes            TagOnQuote[]
}

model TagOnStory {
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id])
  storyId String
  story   Story  @relation(fields: [storyId], references: [id])

  @@id([tagId, storyId])
}

model TagOnWikiEntry {
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id])
  wikiEntryId String
  wikiEntry   WikiEntry @relation(fields: [wikiEntryId], references: [id])

  @@id([tagId, wikiEntryId])
}

model TagOnReview {
  tagId    String
  tag      Tag    @relation(fields: [tagId], references: [id])
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id])

  @@id([tagId, reviewId])
}

model TagOnCharacterAnalysis {
  tagId               String
  tag                 Tag               @relation(fields: [tagId], references: [id])
  characterAnalysisId String
  characterAnalysis   CharacterAnalysis @relation(fields: [characterAnalysisId], references: [id])

  @@id([tagId, characterAnalysisId])
}

model TagOnQuote {
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id])
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id])

  @@id([tagId, quoteId])
}

// --- Faz 2+: Kullanıcı Etkileşimi ---
model Comment {
  id         String   @id @default(cuid())
  content    String   @db.Text
  isApproved Boolean  @default(false)
  isFlagged  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isDeleted  Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  storyId     String?
  story       Story?     @relation(fields: [storyId], references: [id])
  reviewId    String?
  review      Review?    @relation(fields: [reviewId], references: [id])
  wikiEntryId String?
  wikiEntry   WikiEntry? @relation(fields: [wikiEntryId], references: [id])

  @@index([userId])
  @@index([isApproved, isDeleted])
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  storyId     String?
  story       Story?     @relation(fields: [storyId], references: [id])
  reviewId    String?
  review      Review?    @relation(fields: [reviewId], references: [id])
  wikiEntryId String?
  wikiEntry   WikiEntry? @relation(fields: [wikiEntryId], references: [id])

  // Aynı kullanıcı aynı içeriği yalnızca bir kez favorileyebilir
  @@unique([userId, storyId])
  @@unique([userId, reviewId])
  @@unique([userId, wikiEntryId])
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum WikiCategory {
  CHARACTER
  LOCATION
  TERM
  EVENT
  ITEM
  ORGANIZATION
  MAGIC_SYSTEM
}

// Film arşivinde bir filmin nerede durduğu. "Favori" bir durum değil bayraktır:
// izlenmiş bir film aynı anda favori olabilir.
enum MovieStatus {
  WATCHED
  WATCHLIST
  REWATCH
}

// Dizide filmden bir durum fazlası var: bir dizi haftalarca "izleniyor"
// halinde kalabilir — film ya izlendi ya sırada. WATCHING bu yüzden ayrı.
enum ShowStatus {
  WATCHING
  WATCHED
  WATCHLIST
  REWATCH
}

enum BookStatus {
  READ
  READING
  TO_READ
  ABANDONED
}

/// Bir kişinin bir kitaptaki rolü. Yazar, çevirmen ve editör AYNI tabloda
/// (`BookPerson`) duruyor, ayıran şey bu enum.
///
/// Neden ayrı tablolar değil: Türk edebiyatında aynı kişi sık sık iki rolde
/// birden (Sabahattin Ali, Can Yücel, Cemal Süreya hem yazar hem çevirmen).
/// Ayrı tablolarda o kişi iki kez kayıtlı olur ve biyografisi/fotoğrafı iki
/// yerde güncellenirdi. Kaynağın kendi modeli de böyle: 1000Kitap'ta
/// `yazarGruplari[].turId` (1/2/3) üç rolü ayırıyor ama üçü de **aynı kişi
/// kimlik uzayını** kullanıyor — `binKitapId` eşleştirmesi ancak tek tabloda
/// güvenilir çalışır.
enum BookPersonRole {
  AUTHOR
  TRANSLATOR
  EDITOR
}

/// Çeviri durumu. Kullanıcı kararı: beş kitaplık bir serinin üçü Türkçe
/// çıkmışsa kalan iki cilt de arşivde görünsün, ama "henüz çevrilmedi" notuyla.
/// ORIGINAL, Türkçe yazılmış kitap için: orada çeviri diye bir kavram yok ve
/// "çevrildi" demek yanlış olur.
enum BookTranslation {
  TRANSLATED
  UNTRANSLATED
  IN_PROGRESS
  ORIGINAL
}

enum MediaType {
  ANIME
  MOVIE
  TV_SERIES
  BOOK
  MANGA
  GAME
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Kadro düzeltmeleri. Transfermarkt veri seti (Kaggle) yaz transferlerini
// haftalar sonra yansıtıyor — ayrılan oyuncu kadroda kalıyor, yeni transfer
// görünmüyor. Bu tablo sync'in ÜSTÜNE biner: sync serbestçe çalışmaya devam
// eder, buradaki düzeltmeler her zaman uygulanır.
//   tmPlayerId dolu  -> o TM oyuncusu kadrodan gizlenir (ayrıldı)
//   name dolu        -> kadroya elle oyuncu eklenir (yeni transfer)
model SquadOverride {
  id       String  @id @default(cuid())
  teamId   String // TM kulüp id (Galatasaray = 141)

  tmPlayerId String? @unique

  name     String?
  position String?
  age      Int?
  photo    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

// Transfer haberleri — evrene bağlı (şimdilik Galatasaray). Bir habere TM
// oyuncusu bağlanabilir; fotoğraf/mevki/piyasa değeri o kayıttan okunur, haber
// metninde tekrarlanmaz (tek kaynak-doğruluk: TM sync'i).
model TransferNews {
  id          String   @id @default(cuid())
  title       String
  body        String   @db.Text // sanitize edilmiş HTML
  sourceUrl   String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Kulüpte olmayan oyuncular (transfer hedefleri) TM kadromuzda bulunmaz —
  // TM sync'i yalnızca mevcut kadroyu tutar. Böyle haberlerde künye elle
  // girilir. tmPlayerId doluysa TM kaydı önceliklidir.
  manualPlayerName  String?
  manualPlayerPhoto String?
  manualPlayerFacts String? // ör. "Santrfor · 24 yaş · 12 M €"

  universeId String
  universe   WikiUniverse @relation(fields: [universeId], references: [id])

  tmPlayerId String?
  tmPlayer   TmPlayer? @relation(fields: [tmPlayerId], references: [id])

  @@index([universeId, publishedAt])
}

model AmbientTrack {
  id         String       @id @default(cuid())
  title      String
  audioUrl   String
  order      Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  universeId String
  universe   WikiUniverse @relation(fields: [universeId], references: [id])

  @@index([universeId])
}

// --- Transfermarkt Yerel Veri Modelleri (Faz B: API-Football Yerine) ---

model TmCompetition {
  id                 String   @id // TM competition_id
  name               String
  type               String?
  countryName        String?
  domesticLeagueCode String?
  confederation      String?
  url                String?

  clubs TmClub[]
  games TmGame[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TmClub {
  id                    String  @id // TM club_id
  name                  String
  clubCode              String?
  squadSize             Int?
  averageAge            Float?
  stadiumName           String?
  stadiumSeats          Int?
  url                   String?

  domesticCompetitionId String?
  domesticCompetition   TmCompetition? @relation(fields: [domesticCompetitionId], references: [id])

  players   TmPlayer[]
  homeGames TmGame[]   @relation("HomeClub")
  awayGames TmGame[]   @relation("AwayClub")

  transfersIn  TmTransfer[] @relation("ToClub")
  transfersOut TmTransfer[] @relation("FromClub")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domesticCompetitionId])
}

model TmPlayer {
  id               String  @id // TM player_id
  name             String
  firstName        String?
  lastName         String?
  dateOfBirth      DateTime?
  position         String?
  subPosition      String?
  foot             String?
  heightInCm       Int?
  marketValueInEur Float?
  imageUrl         String?
  url              String?
  lastSeason       String?

  currentClubId String?
  currentClub   TmClub? @relation(fields: [currentClubId], references: [id])

  transfers    TmTransfer[]
  transferNews TransferNews[]
  /// Spor arşivi köprüsü (Salon 06). Sanal ters-ilişki: FK sütunu karşı tarafta
  /// (FootballPlayer.tmPlayerId). Bu satır tek başına SIFIR SQL üretir.
  archivePlayers FootballPlayer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([currentClubId])
}

model TmGame {
  id             String  @id // TM game_id
  season         String?
  round          String?
  date           DateTime?
  homeClubGoals  Int?
  awayClubGoals  Int?
  stadium        String?
  attendance     Int?
  referee        String?
  url            String?

  competitionId String?
  competition   TmCompetition? @relation(fields: [competitionId], references: [id])

  homeClubId String?
  homeClub   TmClub? @relation("HomeClub", fields: [homeClubId], references: [id])

  awayClubId String?
  awayClub   TmClub? @relation("AwayClub", fields: [awayClubId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId])
  @@index([homeClubId])
  @@index([awayClubId])
  @@index([date])
}

model TmTransfer {
  id           String    @id @default(cuid()) // kendi ID'miz
  playerId     String
  player       TmPlayer  @relation(fields: [playerId], references: [id])
  
  fromClubId   String?
  fromClub     TmClub?   @relation("FromClub", fields: [fromClubId], references: [id])
  
  toClubId     String?
  toClub       TmClub?   @relation("ToClub", fields: [toClubId], references: [id])
  
  transferDate DateTime?
  transferFee  Float?
  season       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerId])
  @@index([fromClubId])
  @@index([toClubId])
}


// ============================================================================
// SALON 06 · SPOR ARŞİVİ — Faz 1
//
// TEZİ TEK CÜMLEDE: bu bir istatistik veritabanı değil, bir müze kaydıdır.
// Şemanın merkezinde künye değil ANLATI durur. Kronolojik dönem (FootballEra)
// ve an (FootballMoment) birinci sınıf modellerdir; maç, oyuncu, turnuva
// künyesi onlara İSTEĞE BAĞLI takılan ikincil kayıttır — tersi değil.
//
// TAMAMEN EKLEMELİ: mevcut hiçbir tabloya, kolona ya da veriye dokunulmuyor.
// SportPlayer · SportLegend · RaceEvent · DriverStanding olduğu gibi duruyor
// (karar 4). Veri göçü ayrı bir karardır, bu turda yapılmıyor.
//
// --- İKİ DİLLİLİK (karar 1) ------------------------------------------------
// Alan ikizlemesi. Ayrı çeviri tablosu REDDEDİLDİ. Slug TEK ve dilden bağımsız.
//   ÇEVRİLİR   → küratörün yazdığı her cümle: başlık, alt başlık, anlatı,
//                tarihsel bağlam, kişisel not, lakap, rol, alıntı, alt yazı
//   ÇEVRİLMEZ  → özel adlar (kişi, kulüp, pist, takım), sayı, tarih, renk,
//                SVG path, süre biçimi ("1:21.046")
//   ANAHTARDIR → ülke (`countryCode`), mevki ("GK"/"DF"), an türü (`kind`) —
//                bunlar sütun değil çeviri ANAHTARI; karşılığı next-intl'de
//                durur, veritabanı aynı kelimeyi 40 satırda tekrarlamaz.
//                Ev bunu zaten böyle yapıyor (SportPlayer.position yorumu).
// `*Tr` birincil, `*En` opsiyonel: arşiv Türkçe yazılıyor. Ön yüz `en ?? tr`
// okur — İngilizce ziyaretçi boş duvar değil Türkçe metin görür.
//
// --- YAYIN KAPISI · BOŞ ODA YASAĞI (karar 3) --------------------------------
// TEK `isPublished`. Dil başına ikizlenmiş bayrak (isPublishedTr/En) BİLİNÇLE
// REDDEDİLDİ: ikisi de false doğduğu için lansman günü İngilizce ziyaretçiye
// spor kanadının TAMAMI kapalı olurdu — yani boş oda yasağını korumak adına
// asıl boş odayı bayrak üretirdi. Üstelik bayrak metnin varlığını değil
// küratörün tıkladığı düğmeyi ölçer.
//
// Metnin varlığı bayrağa değil, VERİTABANINA emanet edildi. Elle yazılan
// migration'da üç CHECK var (Prisma bunları modellemez ama düşürmez de):
//   FootballEra · FootballLegend · F1Circuit üzerinde
//     CHECK (NOT "isPublished" OR length(btrim(coalesce("narrativeTr",''))) > 0)
// Böylece "yayınlandı ama metni boş" hâli servis nezaketine değil DDL'e bağlı.
// `narrativeTr` bilerek NULLABLE: taslak kaydedilebilsin, yalnızca YAYIN
// anlatı istesin.
//
// `isPublished` YALNIZCA anlatı taşıyan modellerde var. Künye (FootballPlayer,
// FootballMatch, FootballCompetition) tek başına sayfa olmaz, yayın kararı da
// taşımaz.
//
// --- SIRALAMA: ÜÇ AYRI EKSEN, ÇİFT GÖREV YOK --------------------------------
//   orderIndex   → küratörün ekran sırası. Sayfayı yeniden dizmek serbesttir.
//   personalRank → "benim ilk 10'um". null = listede değil. Ekran sırası
//                  değişince BU DEĞİŞMEZ — brief'in istediği kişisel sıralama.
//   isFavorite   → tekil rozet. Sıra değil, işaret.
// Puan alanı YOK: Hagi'ye 8.5 vermek arşivin diliyle çelişir; sıra bir
// tercihtir, puan bir ölçüm.
//
// --- ALAN ADI NOTU ----------------------------------------------------------
// Brief harfiyen `order` diyor; burada `orderIndex` kullanıldı. Ölçüldü:
// `orderIndex` yedi modelde (Story, BookPersonOnEntry, BookQuote, ShowSeason,
// CharacterImage, WikiEntry/BookEntry ilişkileri), `order` yalnızca üç eski
// kayıtta (SportPlayer, SportLegend, AmbientTrack). Yani `orderIndex` yeni bir
// desen İCAT ETMEK değil, evin güncel ve baskın dilini kullanmaktır. Brief'in
// harfine dönüş tek bul-değiştirle mümkün. Aynı gerekçeyle alan adları
// camelCase (`titleTr`), snake_case değil: 1345 satırın tamamı camelCase.
// ============================================================================

/// Bir futbol figürünün işlevi. Gerçekten kapalı bir küme, ve `OTHER` kaçış
/// kapısı var — bu yüzden enum. `FootballMoment.kind` ve turnuva türü ise
/// String anahtar olarak bırakıldı (karar 5: sonradan `ALTER TYPE` gerektiren
/// biçimden kaçınılır; ev deseni `SportPlayer.position`).
enum FootballFigureRole {
  PLAYER
  COACH
  FOUNDER
  PRESIDENT
  OTHER
}

/// Görselin sayfadaki yeri. `CharacterImageSlot` ile birebir aynı desen
/// (schema.prisma ~965) ve aynı gerekçe: künye portresi ile galeri aynı
/// tabloda durur, sorguda slot ile ayrışır.
enum SportImageSlot {
  /// Sayfanın üst şeridi — tek kayıt beklenir
  HERO
  /// Künye portresi
  PORTRAIT
  /// Galeri ızgarası — çok kayıt
  GALLERY
  /// Pist çizimine eşlik eden raster görsel
  TRACK
}

// ---- Futbol · arşiv katmanı (sayfanın özü) ---------------------------------

/// Kulüp dünyası. `/spor/futbol/galatasaray` sayfasının kökü.
///
/// `/spor` sayfası için ayrı bir "SportWorld" vitrin tablosu AÇILMADI: elle
/// açılıp kapanan bir `isPublished` bayrağı, altında tek bir yayınlanmış kulüp
/// yokken "Futbol" kapısını açık bırakabilirdi — yani karar 3'ün yasakladığı
/// boş odayı bizzat üretirdi. Kanat kartları iki `count()` ile beslenir
/// (aşağıdaki indeksler tam bunun için), kanat metinleri next-intl'de durur.
/// Ev bu problemi zaten türetilmiş çözüyor: ambient-tracks.service.ts:28 →
/// `ambientTracks: { some: {} }`.
model FootballClub {
  id   String @id @default(cuid())
  /// Rota anahtarı. Dilden bağımsız, TEK.
  slug String @unique

  /// Özel ad — çevrilmez. "Galatasaray" iki dilde de Galatasaray.
  name         String
  /// "Galatasaray Spor Kulübü" — resmî ad da özel ad
  officialName String?
  /// "GS" — rozet metni, çevrilmez
  shortName    String?
  /// Lakap ÇEVRİLİR: "Cimbom · Aslan" / "The Lions" kültürel taşıyıcıdır
  nicknameTr String?
  nicknameEn String?

  foundedYear Int?
  /// ISO 3166-1 alpha-2 ("TR") — ad değil KOD, çevirisi next-intl'de
  countryCode String?
  /// Şehir adı özel ad; yazım farkı ("İstanbul"/"Istanbul") ön yüzde çözülür
  cityName    String?

  stadiumName     String?
  stadiumCapacity Int?

  crestImage String?
  coverImage String?
  /// Kulübün gerçek dünya renkleri — VERİ, tema token'ı değil
  /// (DriverStanding.teamColor ile aynı gerekçe)
  primaryColor   String?
  secondaryColor String?

  /// Hub kartındaki tek satır
  taglineTr String?
  taglineEn String?
  /// Kulüp sayfasında dönem omurgasından ÖNCEki giriş. Omurga değil, kapı.
  narrativeTr String? @db.Text
  narrativeEn String? @db.Text

  /// `/spor/futbol` hub'ındaki "öne çıkan dünya" bu bayrakla seçilir
  isFeatured  Boolean @default(false)
  isPublished Boolean @default(false)
  orderIndex  Int     @default(0)

  /// Kadim Dünyalar köprüsü — BookEntry.universeId ile birebir aynı desen.
  /// TEK amacı göç ve çapraz geçiş: kulüp sayfası mevcut SportPlayer /
  /// SportLegend / TransferNews / AmbientTrack verisine VERİ TAŞIMADAN
  /// ulaşabilsin (karar 4). Faz 1'de boş kalabilir.
  universeId String?
  universe   WikiUniverse? @relation(fields: [universeId], references: [id])

  /// Transfermarkt kulüp numarası ("141"). Foreign key DEĞİL, düz metin:
  /// `TmClub.id` senkronizasyonun kendi anahtarıdır ve arşiv kaydının bir
  /// senkronizasyon tablosuna bağımlı olması istenmiyor. (Oyuncu tarafında
  /// karar TERSİ — bkz. FootballPlayer.tmPlayerId; sebebi orada yazılı.)
  tmClubId String?

  eras        FootballEra[]
  legends     FootballLegend[]
  players     FootballPlayer[]
  homeMatches FootballMatch[]  @relation("FootballHomeClub")
  awayMatches FootballMatch[]  @relation("FootballAwayClub")
  quotes      SportQuote[]
  images      SportImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  /// Sayfa 1 (`/spor`) sayımı + Sayfa 2 kulüp listesi: süzgeç ve sıralama
  /// tek indeks taramasından karşılanır, ayrı sort adımı çıkmaz.
  @@index([isPublished, isDeleted, orderIndex])
  @@index([isFeatured, isPublished, isDeleted])
  // Kural 14
  @@index([universeId])
}

/// **Kulüp sayfasının omurgası: kronolojik dönem.**
///
/// Dönem bir etiket değil, kendi anlatısını taşıyan bir bölümdür: `narrative`
/// (anlatı), `context` (o yıllarda ülkede/dünyada ne oluyordu), `personalNote`
/// (küratörün sesi). Efsaneler ve maçlar ayrı bir ızgarada DEĞİL, dönemin
/// İÇİNDE yaşar:
///   · anlar (maç, kupa, geliş, ayrılık) → `FootballMoment` (eraId ZORUNLU)
///   · efsaneler                          → `FootballEraFigure` (döneme özel notla)
///
/// Sınırlar SAYI, metin değil. Mevcut `SportLegend.era` alanı "1996–2001" düz
/// metniydi: kronolojik sıralanamıyor, "bu an hangi döneme düşer" sorusuna
/// cevap veremiyordu. `endYear` null = süregelen dönem. Görünen etiket ön yüzde
/// üretilir (tire işareti ve tarih biçimi locale'e göre değişir).
///
/// Sıralama iki eksenli: `startYear` kronolojinin gerçeği, `orderIndex`
/// küratörün üstüne yazdığı sıra (aynı yıl başlayan iki dönem, ya da bir
/// "önsöz" bölümü için). Ev deseni: Story hem `publishedAt` hem `orderIndex`
/// taşıyor.
model FootballEra {
  id String @id @default(cuid())
  /// Kulüp içinde tekil. Sayfa içi çapa ve derin bağlantı:
  /// /spor/futbol/galatasaray#avrupaya-acilan-kapi
  slug String

  startYear Int
  /// null = süregelen dönem ("2023–")
  endYear   Int?

  /// "Avrupa'ya açılan kapı" / "The gateway to Europe"
  titleTr    String
  titleEn    String?
  /// Zaman şeridinde görünen tek satır
  subtitleTr String?
  subtitleEn String?

  /// Dönemin anlatısı — sayfanın özü. NULLABLE ki taslak kaydedilebilsin;
  /// YAYIN için dolu olması migration'daki CHECK ile zorunlu.
  narrativeTr String? @db.Text
  narrativeEn String? @db.Text
  /// Tarihsel bağlam — müze duvarındaki ikinci levha
  contextTr String? @db.Text
  contextEn String? @db.Text
  /// "Bu dönemi ben yaşamadım, babamdan dinledim"
  personalNoteTr String? @db.Text
  personalNoteEn String? @db.Text

  coverImage String?
  /// Dönem şeridinin rengi — VERİ, tema token'ı değil
  accentColor String?

  isPublished Boolean @default(false)
  orderIndex  Int     @default(0)

  clubId String
  club   FootballClub @relation(fields: [clubId], references: [id])

  moments FootballMoment[]
  figures FootballEraFigure[]
  quotes  SportQuote[]
  images  SportImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@unique([clubId, slug])
  /// Sayfa 3'ün EN KRİTİK indeksi. Hem dönem listesini sıralı verir hem de
  /// "bu kulübün yazılmış dönemi var mı" EXISTS'ini ilk üç sütunuyla karşılar.
  @@index([clubId, isPublished, isDeleted, orderIndex])
  /// "Bu an/kupa hangi döneme düşer" — yıl aralığı taraması
  @@index([clubId, startYear])
}

/// **Anlatı atomu: maç değil, AN.**
///
/// Kulübün kuruluşu, Ali Sami Yen'e taşınma, Hagi'nin gelişi, 2000 Kopenhag
/// gecesi, kazanılan kupa — bunların yalnızca biri maçtır. Bu yüzden birinci
/// sınıf model AN'dır; `FootballMatch` ona İSTEĞE BAĞLI takılan künyedir.
/// Anlatısız bir maç veridir; an ise müze levhasıdır.
///
/// Bu ayrım olmadan "1905-1959 Kuruluş ve okul" dönemi tek bir paragraftan
/// ibaret kalır (o yıllarda gösterilecek maç kaydı yok) — yani boş oda.
///
/// Kupa için AYRI TABLO YOK: `kind = "TROPHY"` bir an türüdür. Ayrı bir
/// FootballHonour tablosu kupaları anlatısız bir künye listesine düşürürdü;
/// anlatı öncelikli arşivde kazanılan kupa da bir cümle hak eder.
///
/// `eraId` ZORUNLU: kulüp arşivinde döneme ait olmayan an yoktur. Bu, "her
/// anın bir dönemi vardır" tezinin ve dönem sorgusunun ucuzluğunun bedeli.
/// İleride kulüpten bağımsız bir an gerekirse `ALTER COLUMN DROP NOT NULL`
/// güvenli ve geri alınabilir bir DDL'dir (bkz. migration notları).
model FootballMoment {
  id String @id @default(cuid())

  /// An türü — ÇEVİRİ ANAHTARI, enum değil (karar 5: sonradan `ALTER TYPE`
  /// gerekmesin; ev deseni `SportPlayer.position`). İzinli değerler:
  /// "MILESTONE" · "MATCH" · "TROPHY" · "ARRIVAL" · "DEPARTURE" ·
  /// "TURNING_POINT" · "OTHER". Liste servis DTO'sunda bir birleşim tipi
  /// olarak tutulur; yazım hatası yazma anında yakalanır.
  kind String @default("MILESTONE")

  /// Sıralamanın omurgası — her zaman biliniyor
  year Int
  /// Gün biliniyorsa
  happenedAt DateTime?

  /// Anın başlığı. Bir zaman şeridi satırında BAŞLIK İÇERİKTİR — bu yüzden
  /// `narrativeTr` üzerinde CHECK yok (bkz. blok başındaki yayın kapısı notu).
  titleTr String
  titleEn String?
  narrativeTr String? @db.Text
  narrativeEn String? @db.Text

  /// Müze levhasının tek fotoğrafı. Galeri değil — galeri `SportImage`'ta.
  imageUrl  String?
  captionTr String?
  captionEn String?

  /// `/spor/futbol` hub'ının "tarihten" şeridi yalnızca bunları okur
  isHighlight Boolean @default(false)
  isPublished Boolean @default(false)
  orderIndex  Int     @default(0)

  eraId String
  era   FootballEra @relation(fields: [eraId], references: [id])

  /// Anın kahramanı. Doluysa an, efsanenin kendi sayfasında da görünür —
  /// böylece efsane sayfası anlarını DÖNEMLER ARASINDAN tek taramada toplar,
  /// ikinci bir sahip alanına gerek kalmadan.
  /// Tekil: "Hagi'nin pasında Şükür'ün golü" gibi iki kahramanlı anda
  /// kahraman biri seçilir, diğeri anlatı metninde yaşar. İleride join
  /// tablosu eklemek tamamen ekleyicidir.
  legendId String?
  legend   FootballLegend? @relation(fields: [legendId], references: [id])

  /// Künye eki: skor, tarih, rakip. **Anlatı burada değil.**
  matchId String?
  match   FootballMatch? @relation(fields: [matchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  /// Dönemin içindeki anlar + "bu dönemde gösterilecek bir şey var mı" EXISTS
  @@index([eraId, isPublished, isDeleted, orderIndex])
  /// Efsane sayfası: dönemler arası anlar, kronolojik
  @@index([legendId, isPublished, isDeleted, year])
  /// Hub'ın tarih şeridi
  @@index([isHighlight, isPublished, isDeleted, year])
  /// Dönem şeridinde kupa/geliş süzgeci
  @@index([eraId, kind, isPublished, isDeleted])
  // Kural 14
  @@index([matchId])
}

/// **Efsanenin BİR DÖNEMDEKİ yeri.**
///
/// Neden düz `FootballLegend.eraId` DEĞİL: Fatih Terim aynı kulüpte önce
/// futbolcu, sonra üç ayrı dönemde teknik direktör. Tek foreign key onu bir
/// döneme hapsederdi. Dahası "bu dönemde ne yaptı" cümlesi ne efsaneye ne
/// döneme ait — tam olarak KESİŞİME ait, bu yüzden `roleTr/En` ve `noteTr/En`
/// join'in üstünde durur. Ev bunu zaten kanıtlamış: `BookPersonOnEntry.role`.
///
/// SERT SİLME + Cascade, `isDeleted` YOK — ev desenine birebir uyum
/// (`BookPersonOnEntry`, schema.prisma:669-682). Join'de yumuşak silme
/// kullanılsaydı `@@id([eraId, legendId])` bir KİLİDE dönerdi: arayüzde
/// silinmiş görünen bir satır için `create` P2002 alır ve hatanın sebebi
/// ekranda görünmez. Brief'in "isDeleted her modelde" kuralından bilinçli ve
/// tek sapma budur; gerekçesi ev deseni ve onarılabilirlik.
///
/// KULÜP TUTARLILIĞI: bu tablo "efsane hangi dönemde" sorusunun yetkilisidir,
/// "efsane hangi kulübün" sorusunun DEĞİL — o yetki `FootballLegend.clubId`te.
/// İki yol arasındaki tutarsızlık (Fenerbahçe efsanesini Galatasaray dönemine
/// bağlamak) veritabanı değil SORGU tarafından kapatılır: Sayfa 3'ün figür
/// include'u her zaman `legend: { clubId: <o kulüp> }` süzgeciyle yazılır.
/// Süzgeç `FootballLegend @@index([clubId, isPublished, isDeleted, orderIndex])`
/// tarafından karşılanır, bedeli yoktur. Servis ayrıca bağ kurulurken
/// `era.clubId === legend.clubId` doğrular.
model FootballEraFigure {
  eraId String
  era   FootballEra @relation(fields: [eraId], references: [id], onDelete: Cascade)

  legendId String
  legend   FootballLegend @relation(fields: [legendId], references: [id], onDelete: Cascade)

  /// "dönemin kaptanı" / "captain of the era" — ÇEVRİLİR
  roleTr String?
  roleEn String?
  /// Efsanenin BU dönemdeki tek paragrafı
  noteTr String? @db.Text
  noteEn String? @db.Text

  orderIndex Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([eraId, legendId])
  @@index([eraId, orderIndex])
  /// Kural 14'ün en net örneği: bileşik PK indeksi `eraId` ile BAŞLIYOR, ters
  /// yön (efsane sayfasından dönemlere) onu kullanamaz. Elle yazılmasaydı bu
  /// sorgu seq scan olurdu.
  @@index([legendId])
}

/// Efsane. `/spor/futbol/efsaneler/hagi` — rota kulüpten geçmediği için slug
/// GLOBAL tekil.
///
/// `FootballPlayer` ile ayrımı bilinçli ve BookEntry dersinin aynısı:
/// gösterilen her alan bizim sütunumuz, künye yalnızca tohumlar. Efsane bir
/// futbolcu olmak zorunda değil (Ali Sami Yen kurucudur), bu yüzden `playerId`
/// isteğe bağlı.
///
/// İstatistik sütunu (appearances/goals/assists) BİLİNÇLE YOK: künye
/// `FootballPlayer`da durur. Efsane sayfasında istatistik şeridi istenirse
/// künye üzerinden gelir; anlatı sayfasına sayı yerleştirmek er geç sayfayı
/// istatistik kartına çevirir.
model FootballLegend {
  id   String @id @default(cuid())
  slug String @unique

  /// Özel ad — çevrilmez
  name     String
  /// Künyedeki tam/aksanlı yazım ("Gheorghe Hagi")
  fullName String?
  /// Lakap ÇEVRİLİR: "Karpatların Maradonası" / "The Maradona of the
  /// Carpathians". Lakap bir betimlemedir, özel ad değil.
  epithetTr String?
  epithetEn String?

  role FootballFigureRole @default(PLAYER)

  countryCode String?
  birthYear   Int?
  deathYear   Int?
  /// Kulüpteki yılları — sayı, metin değil (kronolojik sıralanabilsin)
  yearsFrom Int?
  yearsTo   Int?
  shirtNumber Int?

  portraitImage String?
  coverImage    String?

  /// Anlatı — sayfanın özü. Yayın için dolu olması CHECK ile zorunlu.
  narrativeTr String? @db.Text
  narrativeEn String? @db.Text
  contextTr   String? @db.Text
  contextEn   String? @db.Text
  personalNoteTr String? @db.Text
  personalNoteEn String? @db.Text
  /// Satır satır başarı listesi (SportLegend.achievements deseni)
  achievementsTr String? @db.Text
  achievementsEn String? @db.Text

  isFavorite Boolean @default(false)
  /// "Benim ilk 10'um" — null = listede değil. `orderIndex`ten AYRI: ekran
  /// sırasını değiştirmek kişisel sıralamayı bozmasın.
  personalRank Int?
  isPublished  Boolean @default(false)
  orderIndex   Int     @default(0)

  /// Efsanenin kulübü — "hangi kulübün efsanesi" sorusunun TEK YETKİLİSİ.
  /// Nullable: milli takım figürü ya da henüz kulübe bağlanmamış kayıt için.
  /// Dönem bağı `FootballEraFigure`ta; ikisi arasındaki tutarlılık sorgu ve
  /// serviste zorlanır (bkz. FootballEraFigure yorumu).
  clubId String?
  club   FootballClub? @relation(fields: [clubId], references: [id])

  /// Künye eki (isteğe bağlı, tekil). PostgreSQL NULL'ları ayrı saydığı için
  /// künyesiz efsane sayısı sınırsız kalır. Yumuşak silmede servis bu alanı
  /// NULL'lar — yoksa aynı künyeye ikinci bir efsane sayfası açılamazdı.
  playerId String?         @unique
  player   FootballPlayer? @relation(fields: [playerId], references: [id])

  eraFigures FootballEraFigure[]
  moments    FootballMoment[]
  quotes     SportQuote[]
  images     SportImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  /// Hub'ın efsane şeridi
  @@index([isPublished, isDeleted, orderIndex])
  /// "Benim ilk 10'um"
  @@index([isPublished, isDeleted, personalRank])
  /// Kulübün efsaneleri + dönem figürlerinde kulüp tutarlılık süzgeci
  @@index([clubId, isPublished, isDeleted, orderIndex])
}

// ---- Futbol · veri katmanı (Faz 1'de sayfa üretmez) ------------------------

/// Kadro künyesi. Bilinçle İNCE: bir gün API dolduracak, bugün sayfası yok
/// (karar 2 — API-Football ücretsiz planı 2026'yı vermiyor, ölçüldü).
/// `isPublished` taşımaz: künye tek başına sayfa olmaz.
model FootballPlayer {
  id   String  @id @default(cuid())
  /// İleride oyuncu sayfası açılırsa diye; şimdilik boş kalabilir
  slug String? @unique
  name String
  fullName String?

  /// "GK" / "DF" / "MF" / "FW" — çeviri ANAHTARI, ikizlenmez
  /// (SportPlayer.position ile aynı karar)
  position    String?
  shirtNumber Int?
  countryCode String?
  birthDate   DateTime?
  photo       String?

  appearances Int @default(0)
  goals       Int @default(0)
  assists     Int @default(0)

  noteTr String? @db.Text
  noteEn String? @db.Text

  orderIndex Int @default(0)

  clubId String?
  club   FootballClub? @relation(fields: [clubId], references: [id])

  /// Transfermarkt köprüsü — GERÇEK foreign key.
  ///
  /// ÖLÇÜLDÜ, varsayılmadı: `football.service.ts:549` senkronizasyonu
  /// `tmPlayer.upsert` yapıyor ve kadrodan ayrılanların yalnızca
  /// `currentClubId`sini null'lıyor (satır 558); depoda tek bir
  /// `tmPlayer.delete` yok. Dahası `TransferNews.tmPlayerId` (schema:1203)
  /// ZATEN gerçek bir FK. Yani "TmPlayer silinip yeniden yazılıyor, FK
  /// bağlanamaz" gerekçesi doğru değil — düz metin bırakmak yalnızca bayat
  /// bir numaranın sessizce hiçbir yeri göstermesine izin verirdi.
  tmPlayerId String?
  tmPlayer   TmPlayer? @relation(fields: [tmPlayerId], references: [id])

  /// Dış kaynağın ham anlık görüntüsü. Gösterimde kullanılmaz.
  externalData          Json?
  externalDataFetchedAt DateTime?

  legend FootballLegend?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([clubId, isDeleted, orderIndex])
  // Kural 14
  @@index([tmPlayerId])
}

/// Maç künyesi: skor, tarih, rakip. **Anlatı burada değil** — anlatı
/// `FootballMoment`tedir. Bu ayrım şemanın tezidir.
///
/// Döneme BAĞLANMAZ: maçın dönemle ilişkisi onu anan `FootballMoment`
/// üzerinden kurulur. Böylece "kulüp bağı iki yerde" çelişkisi maç tarafında
/// hiç doğmaz.
model FootballMatch {
  id       String    @id @default(cuid())
  playedAt DateTime?
  /// Sezonun BAŞLANGIÇ yılı (1999). "1999-2000" metni türetilir, tutulmaz:
  /// tire biçimi locale'e göre değişir ve metinle sıralama yanlış çalışır.
  seasonStartYear Int?
  /// Tur aşaması ANAHTARI: "FINAL" · "SEMI_FINAL" · "LEAGUE" · "DERBY".
  /// Enum değil String (karar 5).
  stage String?

  homeGoals Int?
  awayGoals Int?
  /// 2000 UEFA Kupası finali 0-0 bitti, kupa penaltılarla geldi. Galatasaray
  /// arşivinin en önemli tek maçı bu sütunlar olmadan yazılamaz.
  homePenalties Int?
  awayPenalties Int?

  venueName  String?
  attendance Int?

  competitionId String?
  competition   FootballCompetition? @relation(fields: [competitionId], references: [id])

  /// Rakip kulüp kaydı VARSA ilişki, yoksa düz ad. `TransferNews.manualPlayerName`
  /// deseninin aynısı (schema:1193-1198): ilişki doluysa O önceliklidir.
  /// Bu sütunlar olmadan "1999 Kopenhag" macını yazmak için önce Arsenal'i tam
  /// bir kulüp kaydı olarak açmak gerekirdi — arşivi öldüren tam bu vergidir.
  homeClubId String?
  homeClub   FootballClub? @relation("FootballHomeClub", fields: [homeClubId], references: [id])
  homeName   String?
  homeCrest  String?
  awayClubId String?
  awayClub   FootballClub? @relation("FootballAwayClub", fields: [awayClubId], references: [id])
  awayName   String?
  awayCrest  String?

  /// Dış kaynak numarası. TEKİL DEĞİL, düz indeks: ileride iki farklı
  /// kaynaktan (API-Football + Transfermarkt) numara gelirse tekil kısıt içe
  /// aktarmayı sessizce kilitlerdi. Tekrar koruması serviste.
  externalId            String?
  externalData          Json?
  externalDataFetchedAt DateTime?

  moments FootballMoment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  // Kural 14
  @@index([competitionId])
  @@index([homeClubId, isDeleted, playedAt])
  @@index([awayClubId, isDeleted, playedAt])
  @@index([externalId])
}

/// Turnuva künyesi. Faz 1'de kendi sayfası YOK — anın hangi kulvarda geçtiğini
/// söylemek için var ("1999-00 UEFA Kupası").
///
/// Ad ÇEVRİLİR: "Şampiyonlar Ligi" / "Champions League" özel ad değil, kurumun
/// yerelleşmiş adıdır — kulüp adının aksine.
model FootballCompetition {
  id   String @id @default(cuid())
  slug String @unique

  nameTr String
  nameEn String?
  /// "UCL", "TSL" — rozet altındaki dilsiz kısaltma
  shortName String?

  /// Tür ANAHTARI: "LEAGUE" · "DOMESTIC_CUP" · "EUROPEAN" · "OTHER"
  type            String?
  countryCode     String?
  isInternational Boolean @default(false)
  logoImage       String?

  orderIndex Int @default(0)

  externalId String?

  matches FootballMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([isDeleted, orderIndex])
}

// ---- Formula 1 · arşiv katmanı ---------------------------------------------

/// Pist. `/spor/formula-1/pistler/monza` — sayfanın MERKEZİNDE SVG çizim var.
///
/// `trackSvgPath` tek başına işe yaramaz: `trackSvgViewBox` olmadan rastgele
/// bir path ekrana doğru ölçekte oturmaz. Mevcut `RaceEvent.trackSvgPath` bu
/// eksikle duruyor; burada tekrarlanmıyor.
model F1Circuit {
  id   String @id @default(cuid())
  slug String @unique

  /// Özel ad — çevrilmez
  name         String
  /// "Autodromo Nazionale di Monza" — resmî ad da özel ad
  officialName String?
  /// "Hız Tapınağı" / "The Temple of Speed" — ÇEVRİLİR, sayfanın ruhu
  nicknameTr String?
  nicknameEn String?

  countryCode        String?
  cityName           String?
  firstGrandPrixYear Int?
  /// Takvimde hâlâ var mı — arşivde duran ölü pistler için
  isActive Boolean @default(true)

  lengthMeters Int?
  cornerCount  Int?
  drsZones     Int?
  /// Saat yönünde mi — çizimin ok yönü buradan
  isClockwise Boolean?

  /// Tur rekoru. Süre METİN ("1:21.046"): milisaniyeye çevirmek biçimi
  /// kaybettirir ve sıralama ihtiyacı yok.
  lapRecordTime     String?
  lapRecordYear     Int?
  /// Rekor sahibi FK — düz ad olsaydı "bu pistin rekoru bende" bağlantısı
  /// sürücü sayfasından kurulamazdı. Sürücü kaydı yoksa boş kalır.
  lapRecordDriverId String?
  lapRecordDriver   F1Driver? @relation("F1CircuitLapRecord", fields: [lapRecordDriverId], references: [id])

  /// Pistin tek çizgi SVG path verisi (d attribute) — RaceEvent.trackSvgPath
  /// ile aynı desen ve aynı ad.
  trackSvgPath String? @db.Text
  /// "0 0 800 600" — path'in ölçek kutusu. Path varsa bu da olmalı.
  trackSvgViewBox String?
  /// Başlangıç/bitiş çizgisinin path üstündeki konumu (0-1) — işaret koymak için
  startLineOffset Float?

  coverImage  String?
  accentColor String?

  /// Anlatı — sayfanın özü. Yayın için dolu olması CHECK ile zorunlu.
  narrativeTr String? @db.Text
  narrativeEn String? @db.Text
  contextTr   String? @db.Text
  contextEn   String? @db.Text
  personalNoteTr String? @db.Text
  personalNoteEn String? @db.Text

  isFavorite   Boolean @default(false)
  personalRank Int?
  isPublished  Boolean @default(false)
  orderIndex   Int     @default(0)

  corners F1CircuitCorner[]
  results F1RaceResult[]
  moments F1Moment[]
  quotes  SportQuote[]
  images  SportImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  /// Sayfa 1 sayımı + Sayfa 5 pist dizini
  @@index([isPublished, isDeleted, orderIndex])
  @@index([isPublished, isDeleted, personalRank])
  // Kural 14
  @@index([lapRecordDriverId])
}

/// Adı olan viraj: "Parabolica", "Variante Ascari", "Eau Rouge".
///
/// Sayfa 6'yı gerçekten SAYFA yapan parça: SVG çizimi bir resim olmaktan çıkıp
/// okunabilir bir metne dönüşüyor. `markerX/markerY` pistin `trackSvgViewBox`
/// koordinat sistemindeki konumdur — etiket oraya konur.
model F1CircuitCorner {
  id     String @id @default(cuid())
  number Int?
  /// Virajın yerleşik özel adı — çevrilmez
  name   String?
  /// Küratörün taktığı ad — ÇEVRİLİR
  nicknameTr String?
  nicknameEn String?

  noteTr String? @db.Text
  noteEn String? @db.Text

  markerX Float?
  markerY Float?

  isPublished Boolean @default(false)
  orderIndex  Int     @default(0)

  circuitId String
  circuit   F1Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([circuitId, isPublished, isDeleted, orderIndex])
}

/// F1'in anlatı atomu — `FootballMoment`in karşılığı. Simetri kasıtlı: iki
/// kanadın da omurgası bir anlatı birimi.
///
/// Bu model aynı zamanda `F1Season` / `F1Driver` / `F1Team` üçlüsünü Faz 1'in
/// sayfalarına bağlayan TEK köprüdür; o olmasaydı üç tablo açılıp altı sayfanın
/// hiçbirine ulaşamazdı.
///
/// `seasonYear` HER ZAMAN dolu ve sıralamanın omurgası; `seasonId` yalnızca o
/// yıl için yazılmış bir sezon kaydı VARSA dolar — küratör 1988 Monza için tek
/// bir an yazarken önce sezon kaydı açmak zorunda kalmasın (FootballMatch.homeName
/// ile aynı gerekçe). İkisinin senkron kalması servisin işi: sezon bağlanırken
/// `seasonYear = season.year` yazılır.
model F1Moment {
  id String @id @default(cuid())

  seasonYear Int
  happenedAt DateTime?

  titleTr String
  titleEn String?
  narrativeTr String? @db.Text
  narrativeEn String? @db.Text

  imageUrl  String?
  captionTr String?
  captionEn String?

  isHighlight Boolean @default(false)
  isPublished Boolean @default(false)
  orderIndex  Int     @default(0)

  circuitId String?
  circuit   F1Circuit? @relation(fields: [circuitId], references: [id])
  seasonId  String?
  season    F1Season?  @relation(fields: [seasonId], references: [id])
  driverId  String?
  driver    F1Driver?  @relation(fields: [driverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  /// Sayfa 6: "burada yaşananlar", kronolojik
  @@index([circuitId, isPublished, isDeleted, seasonYear])
  @@index([seasonId, isPublished, isDeleted, orderIndex])
  @@index([driverId, isPublished, isDeleted, seasonYear])
  @@index([isHighlight, isPublished, isDeleted, seasonYear])
}

/// Sezon. F1'de dönem bir yıldır — `FootballEra`nın karşılığı. Faz 1'de kendi
/// sayfası yok.
///
/// `year` TEKİL DEĞİL, düz indeks: yumuşak silinmiş bir sezonu yeniden girmek
/// `-deleted-{timestamp}` numarasıyla serbestleştirilemeyen bir Int kısıtına
/// çarpardı ve arayüzden onarılamayan bir P2002 üretirdi. Tekillik `slug`ta
/// (o serbestleştirilebilir) ve serviste.
model F1Season {
  id   String @id @default(cuid())
  /// "2000" — rota ve tekillik anahtarı
  slug String @unique
  year Int

  /// "İki takımın son savaşı" — ÇEVRİLİR
  titleTr String?
  titleEn String?
  narrativeTr String? @db.Text
  narrativeEn String? @db.Text
  personalNoteTr String? @db.Text
  personalNoteEn String? @db.Text

  coverImage String?

  /// Şampiyon FK — düz metin "Michael Schumacher" DEĞİL: sürücü sayfası
  /// açıldığında "şampiyon olduğu yıllar" bölümü metin taramasıyla kurulamaz.
  championDriverId String?
  championDriver   F1Driver? @relation("F1SeasonChampionDriver", fields: [championDriverId], references: [id])
  championTeamId   String?
  championTeam     F1Team?   @relation("F1SeasonChampionTeam", fields: [championTeamId], references: [id])

  isPublished Boolean @default(false)
  orderIndex  Int     @default(0)

  moments F1Moment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([isPublished, isDeleted, year])
  // Kural 14
  @@index([championDriverId])
  @@index([championTeamId])
}

/// Sürücü. Faz 1'de sayfası yok; rota ve model hazır (brief isteği).
///
/// `teamId` diye düz bir alan BİLİNÇLE YOK: Hamilton McLaren, Mercedes ve
/// Ferrari sürdü — o alan ilk günden yanlış olurdu. Faz 2'de sürücü-takım-sezon
/// üçlüsü (`F1DriverSeason`) tamamen EKLEYİCİ olarak gelebilir.
model F1Driver {
  id   String @id @default(cuid())
  slug String @unique

  /// Özel ad — çevrilmez
  name     String
  fullName String?
  /// Lakap ÇEVRİLİR: "Yağmur Kralı" / "The Rain Master"
  nicknameTr String?
  nicknameEn String?

  countryCode String?
  birthYear   Int?
  deathYear   Int?
  activeFrom  Int?
  activeTo    Int?
  /// 2014 sonrası sabit numara
  permanentNumber Int?

  championships Int @default(0)
  wins          Int @default(0)
  poles         Int @default(0)

  photo String?

  /// Jolpica/Ergast sürücü kimliği ("max_verstappen"). Senkronizasyonun
  /// eşleştirme anahtarı; ad üstünden eşleştirme kırılgan (aksan, "Pérez"
  /// / "Perez", "Nino Farina" / "Giuseppe Farina").
  externalId String? @unique

  /// ---- Portre künyesi (Wikimedia Commons) ----
  /// Görselin kendisi `photo` alanında ve KENDİ sunucumuzda (/uploads/…):
  /// CSP dış adrese izin vermiyor ve dış adres bir gün ölüyor.
  ///
  /// Bu üç alan yasal zorunluluk, süs değil: Commons görsellerinin çoğu
  /// CC BY / CC BY-SA, yani kaynak ve fotoğrafçı GÖSTERİLMEK ZORUNDA.
  /// Ölçüldü (8 Ağustos 2026): altı sürücünün beşinde lisans + sanatçı
  /// eksiksiz geliyor (CC BY-SA 4.0, CC BY 4.0, kamu malı karışık).
  /// Üçü birden dolu değilse görsel GÖSTERİLMEZ — atıfsız yayın, telifli
  /// görseli izinsiz kullanmakla aynı kapıya çıkar.
  portraitSourceUrl String?
  portraitLicense   String?
  portraitAuthor    String?

  narrativeTr String? @db.Text
  narrativeEn String? @db.Text
  personalNoteTr String? @db.Text
  personalNoteEn String? @db.Text

  isFavorite   Boolean @default(false)
  personalRank Int?
  isPublished  Boolean @default(false)
  orderIndex   Int     @default(0)

  raceResults     F1RaceResult[]
  championSeasons F1Season[]   @relation("F1SeasonChampionDriver")
  lapRecords      F1Circuit[]  @relation("F1CircuitLapRecord")
  moments         F1Moment[]
  quotes          SportQuote[]
  images          SportImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([isPublished, isDeleted, orderIndex])
  @@index([isPublished, isDeleted, personalRank])
}

/// Takım (constructor). Faz 1'de sayfası yok; rota ve model hazır.
model F1Team {
  id   String @id @default(cuid())
  slug String @unique

  /// Özel ad — çevrilmez
  name     String
  fullName String?

  countryCode String?
  foundedYear Int?
  /// Takımın gerçek dünya rengi — VERİ, tema token'ı değil
  teamColor String?
  logoImage String?

  narrativeTr String? @db.Text
  narrativeEn String? @db.Text

  isPublished Boolean @default(false)
  orderIndex  Int     @default(0)

  championSeasons F1Season[] @relation("F1SeasonChampionTeam")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([isPublished, isDeleted, orderIndex])
}

// ---- Ortak arşiv parçaları --------------------------------------------------

/// Alıntı. `BookQuote`un spor karşılığı — sayfa yerine yıl, bağlam aynı.
///
/// Beş nullable sahip: kulüp · dönem · efsane · pist · sürücü. TAM BİRİ dolu
/// olur. Bu depoda yerleşik desen (`Comment` üç, `Favorite` üç nullable
/// sahiple çalışıyor); enum ayrımlı `ownerType/ownerId` REDDEDİLDİ, referans
/// bütünlüğünü kaybettirirdi.
///
/// Ev deseninin sağlamadığı güvence migration'a elle yazılan bir CHECK ile
/// kapatıldı: `num_nonnulls(...) = 1`. Test edilemeyen bir veritabanında
/// "istenirse" değil ŞART — beş sahibi de boş bir satır hiçbir yerde görünmez
/// (sessiz yetim), iki sahibi dolu bir satır iki sayfada birden çıkar.
///
/// `FootballMoment` sahip listesinde YOK: an zaten kendi anlatısını, tek
/// görselini ve alt yazısını taşıyor — anın içindeki söz anlatı metninde
/// yaşar. Alıntı bölümü dönemin ya da efsanenin sayfa öğesidir.
model SportQuote {
  id String @id @default(cuid())

  /// Alıntı metni ÇEVRİLİR: bir sözün İngilizcesi çeviridir.
  textTr String  @db.Text
  textEn String? @db.Text
  /// "Kim söyledi" — özel ad, çevrilmez
  attribution String?
  /// "Hangi maçtan sonra" — cümle olduğu için çevrilir (BookQuote.context deseni)
  contextTr String?
  contextEn String?
  year      Int?

  isFavorite  Boolean @default(false)
  isPublished Boolean @default(false)
  orderIndex  Int     @default(0)

  clubId String?
  club   FootballClub? @relation(fields: [clubId], references: [id], onDelete: Cascade)
  eraId  String?
  era    FootballEra?  @relation(fields: [eraId], references: [id], onDelete: Cascade)
  legendId String?
  legend   FootballLegend? @relation(fields: [legendId], references: [id], onDelete: Cascade)
  circuitId String?
  circuit   F1Circuit?     @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  driverId  String?
  driver    F1Driver?      @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  // Kural 14 — her sahip için ayrı, hepsi sıralı okunuyor
  @@index([clubId, isPublished, isDeleted, orderIndex])
  @@index([eraId, isPublished, isDeleted, orderIndex])
  @@index([legendId, isPublished, isDeleted, orderIndex])
  @@index([circuitId, isPublished, isDeleted, orderIndex])
  @@index([driverId, isPublished, isDeleted, orderIndex])
}

/// Seçilmiş görsel — GALERİ ve künye portresi için. `CharacterImage` deseni.
///
/// Tek kapak görselleri sahibin kendi sütununda durur (`coverImage`,
/// `crestImage`, `portraitImage`); bir görsel için tabloya gitmek gereksiz.
/// Anın tek fotoğrafı da `FootballMoment.imageUrl`dadır.
///
/// Adres her zaman kendi sunucumuz (`/uploads/…`): CSP yabancı sunucuya izin
/// vermiyor ve dış adres bir gün ölüyor (CharacterImage.url yorumu).
///
/// Sahip kuralı ve CHECK'i `SportQuote` ile aynı.
model SportImage {
  id   String         @id @default(cuid())
  slot SportImageSlot @default(GALLERY)
  url  String

  /// Erişilebilirlik metni ve alt yazı ÇEVRİLİR
  altTr     String?
  altEn     String?
  captionTr String?
  captionEn String?
  /// "kaynak: kulüp arşivi" — künye satırı, çevrilmez
  sourceNote String?

  orderIndex Int @default(0)

  clubId String?
  club   FootballClub? @relation(fields: [clubId], references: [id], onDelete: Cascade)
  eraId  String?
  era    FootballEra?  @relation(fields: [eraId], references: [id], onDelete: Cascade)
  legendId String?
  legend   FootballLegend? @relation(fields: [legendId], references: [id], onDelete: Cascade)
  circuitId String?
  circuit   F1Circuit?     @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  driverId  String?
  driver    F1Driver?      @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  // Kural 14 — `slot` ikinci sırada: CharacterImage @@index([characterId, slot,
  // isDeleted]) ile birebir aynı desen. Sorgular her zaman slot ile geliyor
  // ("portreyi ver", "galeriyi ver"); slot'suz sorgu da önekten faydalanır.
  @@index([clubId, slot, isDeleted, orderIndex])
  @@index([eraId, slot, isDeleted, orderIndex])
  @@index([legendId, slot, isDeleted, orderIndex])
  @@index([circuitId, slot, isDeleted, orderIndex])
  @@index([driverId, slot, isDeleted, orderIndex])
}

/// **Bir yarışın podyumu — VERİ katmanı.**
///
/// Brief'in §6 kuralı: dış API asla render'da çağrılmaz, günde bir çalışan
/// senkronizasyon veriyi KENDİ veritabanımıza yazar, sağlayıcı çökse de site
/// bozulmaz. Bu tablo o kuralın F1 tarafındaki karşılığı.
///
/// YALNIZCA İLK ÜÇ tutuluyor (kullanıcı kararı). Tam sonuç tablosu bir
/// istatistik veritabanının işi; burası arşiv — podyum bir sayfanın
/// hatırlayacağı şeydir, 20. sıra değil.
///
/// `driverName` düz metin olarak DA duruyor (`F1Driver` ilişkisinin yanında):
/// `FootballMatch.homeName` ile aynı gerekçe — sürücü kaydı henüz açılmamışken
/// de satır yazılabilsin. İlişki doluysa O önceliklidir.
model F1RaceResult {
  id String @id @default(cuid())

  seasonYear Int
  round      Int?
  /// "Italian Grand Prix" — kurumun kendi adı, çevrilmez
  raceName   String?
  raceDate   DateTime?

  /// 1, 2, 3 — yalnızca podyum
  position Int

  driverName        String
  driverNationality String?
  constructorName   String?
  /// "1:13:41.143" (kazanan) ya da "+6.064" (fark) — METİN: biçim locale'e
  /// göre değişmiyor ve milisaniyeye çevirmek gösterimi kaybettiriyor.
  timeText String?

  circuitId String
  circuit   F1Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  /// Sürücü künyesi varsa bağlanır; yoksa `driverName` yeter
  driverId String?
  driver   F1Driver? @relation(fields: [driverId], references: [id])

  /// Hangi sağlayıcıdan geldi — sağlayıcı değişirse eski satırlar ayırt edilsin
  externalSource    String    @default("jolpica")
  externalFetchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  /// Aynı pistte aynı yılın aynı basamağı bir kez. Senkronizasyon bu anahtar
  /// üzerinden `upsert` ediyor, yani tekrar çalıştırmak kopya üretmiyor.
  @@unique([circuitId, seasonYear, position])
  /// Pist sayfasının tek sorgusu: yıla göre sıralı podyum listesi
  @@index([circuitId, isDeleted, seasonYear, position])
  // Kural 14
  @@index([driverId])
}

// ═══════════════════════════════════════════════════════════════════════════
// SALON 06 · MÜZİK ARŞİVİ — Faz 1 (çekirdek katalog)
//
// Tasarım kararları ve gerekçeleri: `docs/muzik-bolumu-inceleme.md`.
// Kullanıcı planı: `docs/kuronexus-muzik-bolumu-tasarim-plani.md`.
// ÇELİŞKİDE İNCELEME DOSYASI KAZANIR — plan başka bir projeden (ultnexus)
// gelen varsayımlar taşıyor.
//
// ── NEDEN HER AD `Music` ÖNEKLİ ───────────────────────────────────────────
// Plan çıplak adlar öneriyordu (Role, Person, Track, Genre, Album). Üçü bu
// şemada ÇAKIŞIYOR ve biri doğrudan derleme hatası:
//   Role   → `enum Role { ADMIN EDITOR VIEWER }` zaten var (bkz. yukarı).
//            Prisma model ve enum adlarını aynı isim uzayında tutar.
//   Track  → `AmbientTrack` (evren fon sesi) + F1'de "pist" anlamında
//            (`prisma/add-track-image.ts`). Üç kavram tek kelimeye sığmaz.
//   Person → `BookPerson` var. "Hangi Person?" sorusu her sorguda doğardı.
// Zaten projenin deseni bu: Book*, Football*, F1*, Sport*, Anime*, Movie*.
//
// ── SPOTIFY ŞEMAYI BELİRLEMEZ ─────────────────────────────────────────────
// Spotify'ın modelinde kişi/grup ayrımı YOK; hepsi "artist". Bizde var.
// Sync'ten gelen her artist `MusicalAct` olarak açılır ve `actKind`
// UNCLASSIFIED kalır — BAND varsayılanı Hans Zimmer'ı sessizce "grup"
// yapardı. `MusicPerson` yalnızca küratör açar.
//
// ── SYNC'İN YAZMA İZNİ (değişmez kural) ───────────────────────────────────
// Senkronizasyon YALNIZCA şu tablolara yazar: MusicPerson, MusicalAct,
// MusicAlbum, MusicTrack, MusicTrackCredit, MusicGenre (isApproved: false),
// MusicGenreOnAct, MusicExternalRef, MusicSyncState.
// Faz 2'de gelecek kişisel katmana (MusicRating/MusicNote/MusicFavorite/
// MusicPersonalEra) ve küratör verisi olan MusicEra/MusicRole'e HİÇBİR kod
// yolundan yazmaz. Kişisel alanlar bu yüzden aynı tabloda değil: `data:
// { ...spotifyPayload }` biçiminde bir yazma bir gün yazılırsa aynı satırdaki
// puanı/notu sessizce silerdi. Ayrı tabloda bu imkânsız.
// ═══════════════════════════════════════════════════════════════════════════

/// Gerçek kişi (Chester Bennington, Hans Zimmer).
///
/// Spotify bu ayrımı vermediği için kayıtlar **küratör eliyle** açılır. Solo
/// sanatçıda hem `MusicPerson` hem `MusicalAct` durur ve aralarını
/// `MusicMembership` bağlar — albümler `MusicAlbum.actId` üstünden asılı
/// olduğu için Person tek başına dururken sayfası boş kalırdı.
model MusicPerson {
  id   String @id @default(cuid())
  /// Rota anahtarı: `/muzik/kisi/chester-bennington`. Adres Spotify kimliği
  /// üstünden KURULMAZ — kaynak değişse de adres kalıcı olsun (SEO).
  slug String @unique
  name String
  /// "Bennington, Chester" — listeleme sırası. Ad alanı gösterim için.
  sortName String?

  birthDate     DateTime?
  deathDate     DateTime?
  originCountry String?

  /// Küratör metni. Dış kaynaktan GELMEZ (kural 4: dış veri ile kendi
  /// içeriğimiz ayrı; sync buraya dokunmaz).
  bio String? @db.Text

  /// Kendi diskimizdeki yol (`/uploads/music/…`). Hotlink yasak — hem CSP
  /// yabancı sunucuya izin vermiyor hem dış adres bir gün ölüyor.
  photo          String?
  /// Orijinal kaynak adresi; yerelleştirmeden vazgeçilirse tek dayanak.
  photoSourceUrl String?
  /// `null` = indirilemedi. Cron sonraki turda yeniden dener (ayrı kuyruk yok).
  photoFetchedAt DateTime?

  spotifyId String? @unique

  /// Dış kaynağın ham anlık görüntüsü (kural 4/14). Gösterimde kullanılmaz;
  /// sütunlar bundan tohumlanır.
  externalData          Json?
  externalDataFetchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  memberships   MusicMembership[]
  trackCredits  MusicTrackCredit[]
  externalRefs  MusicExternalRef[]

  @@index([isDeleted, name])
}

/// Grup / solo proje / orkestra (Linkin Park, Dead by Sunrise).
model MusicalAct {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  sortName String?

  /// Act'in **ontolojik türü** — "bu oluşum ne". Kişinin üstlendiği
  /// profesyonel işlev (`MusicRole`) ile KARIŞTIRILMAZ: Hans Zimmer'ın
  /// act'i SOLO_PROJECT, rolü Composer + Producer.
  ///
  /// Varsayılan bilinçli olarak UNCLASSIFIED: sync sınıflandırma yapamaz,
  /// BAND varsayılanı yanlış veriyi sessizce yerleştirirdi. Sınıflandırılmamış
  /// act'ler admin panelde kuyrukta görünür.
  actKind MusicActKind @default(UNCLASSIFIED)

  formedYear    Int?
  disbandedYear Int?
  originCity    String?
  originCountry String?

  /// Küratör metni — sync dokunmaz.
  bio String? @db.Text

  image          String?
  imageSourceUrl String?
  imageFetchedAt DateTime?

  /// Sanatçı sayfasının üst bandı — kare `image`den AYRI bir varlık
  /// (tasarım 2c: 2000×640). Aynı dosyayı iki oranda kırpmak künye
  /// portresini de banda feda ederdi. `AnimeEntry` banner alanlarıyla
  /// aynı gerekçe (migration `20260729190000_add_anime_banner_links`).
  bannerImage     String?
  bannerSourceUrl String?
  bannerFetchedAt DateTime?

  /// Bandın odak noktası — CSS `background-position` değeri ("50% 30%").
  ///
  /// ⚠️ NEDEN GEREKLİ: bant 2000×640 oranında kırpılıyor ve yüklenen görselin
  /// neresinin görüneceğine tarayıcı karar veriyordu (varsayılan ortası).
  /// Grup fotoğraflarında yüzler üst üçte bir bandında olduğu için ortadan
  /// kırpma **yüzleri kesiyordu** (kullanıcı bildirimi, 13 Ağustos 2026).
  ///
  /// Renk DEĞİL konum tutuluyor, yani kural 16 ihlali yok: bu bir düzen
  /// değeri ve temadan bağımsız. `null` ise CSS varsayılanı ("50% 50%")
  /// geçerli — mevcut kayıtlar için davranış değişmiyor.
  bannerPosition  String?

  /// Spotify metriği; dış veri sayılır, sync günceller.
  popularity Int?
  followers  Int?

  spotifyId String? @unique

  externalData          Json?
  externalDataFetchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  albums       MusicAlbum[]
  memberships  MusicMembership[]
  genres       MusicGenreOnAct[]
  eras         MusicEra[]
  trackCredits MusicTrackCredit[]
  externalRefs MusicExternalRef[]

  @@index([isDeleted, name])
  @@index([actKind, isDeleted])
}

/// Künye rolü — **kontrollü sözlük**, serbest metin DEĞİL.
///
/// Spotify rol bilgisi vermiyor; bu tablo tamamen bizim. O yüzden
/// `MusicGenre`deki `isApproved` kapısı burada YOK — dışarıdan gelen bir şey
/// olmadığı için onaylanacak bir şey de yok. Sözlük `prisma/seed.ts`ten kurulur.
///
/// Görünen etiket bu tabloda TUTULMAZ: `key` bir çeviri anahtarıdır ve metin
/// `messages/tr.json|en.json` → `music.roles.<key>` içinde durur (kural 1).
/// `BookGenre.key` ile aynı desen.
model MusicRole {
  id  String @id @default(cuid())
  /// "vocalist", "composer", "producer" — i18n anahtarı
  key String @unique
  /// Rota/süzgeç anahtarı
  slug String @unique
  /// Künyede görünme sırası; küçük olan önce
  orderIndex Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  MusicMembership[]
  trackCredits MusicTrackCredit[]
}

/// Kişi ↔ act üyeliği, rol ve tarih aralığıyla.
///
/// ⚠️ `BookPersonOnEntry`den ayrıldığı yer: orada bileşik `@@id([entryId,
/// personId, role])` var. Burada olamaz — **ayrılıp geri dönen üye** aynı
/// (act, person, rol) üçlüsünü iki ayrı tarih aralığıyla taşır ve bileşik
/// anahtar ikinci dönemi engellerdi. Bu müzikte istisna değil, kural.
model MusicMembership {
  id String @id @default(cuid())

  personId String
  person   MusicPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  actId    String
  act      MusicalAct  @relation(fields: [actId], references: [id], onDelete: Cascade)
  roleId   String
  role     MusicRole   @relation(fields: [roleId], references: [id])

  startedAt DateTime?
  endedAt   DateTime?
  /// Hâlâ kadroda mı. `endedAt` doluysa false olması beklenir ama tarihi
  /// bilinmeyen ayrılıklar için ayrı bayrak gerekiyor.
  isCurrent Boolean @default(true)

  orderIndex Int     @default(0)
  /// Küratör notu ("2007'de kısa süre konuk vokal") — sync dokunmaz
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Aynı dönem iki kez girilmesin; `startedAt` null olan tek satır olabilir
  @@unique([actId, personId, roleId, startedAt])
  // Kural 14
  @@index([personId])
  @@index([actId, orderIndex])
  @@index([roleId])
}

/// Albüm. Spotify'da single ve derleme de "album" olarak döner — ayıran
/// `albumType`. O alan olmasa albüm listesi kırk single'la dolar ve "albüm
/// listesi" olmaktan çıkardı.
model MusicAlbum {
  id    String @id @default(cuid())
  slug  String @unique
  title String
  /// Orijinal dildeki ad; çevrilmiş/yerelleştirilmiş adla birlikte gösterilir
  originalTitle String?

  albumType MusicAlbumType @default(ALBUM)

  releaseDate DateTime?
  /// Spotify tarih hassasiyetini ayrıca veriyor (year / month / day). Bu alan
  /// olmadan yalnızca yılı bilinen bir albüm sayfada "1 Ocak 2003" diye
  /// uydurulmuş bir günle görünürdü.
  releaseDatePrecision String?

  totalTracks Int?
  label       String?
  popularity  Int?

  /// Kapak: kendi diskimizde. `book-cover.service.ts` deseni — Spotify CDN'ine
  /// hotlink YAPILMAZ (kullanıcı kararı).
  artwork          String?
  artworkSourceUrl String?
  /// `null` = inmedi; cron eksikleri toplar. Ayrı retry kuyruğu tablosu yok.
  artworkFetchedAt DateTime?

  spotifyId String? @unique

  externalData          Json?
  externalDataFetchedAt DateTime?

  actId String
  act   MusicalAct @relation(fields: [actId], references: [id], onDelete: Cascade)

  /// Dönem bağı **açık FK** — tarih aralığından otomatik eşleme yapılmıyor
  /// (kullanıcı kararı). ⚠️ Bu alanı dolduran admin formu Faz 3'ün çıkış
  /// şartı: `BookEntry.universeId` de "opsiyonel, elle doldurulur" diye
  /// eklendi ve formu hiç yapılmadığı için 32 serinin hiçbirinde dolu değil.
  eraId String?
  era   MusicEra? @relation(fields: [eraId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  tracks       MusicTrack[]
  externalRefs MusicExternalRef[]

  /// Sanatçı sayfasının tek sorgusu: türe göre ayrılmış, tarihe göre sıralı
  @@index([actId, albumType, isDeleted])
  @@index([actId, releaseDate])
  // Kural 14
  @@index([eraId])
}

/// Parça.
///
/// ⚠️ `previewUrl` BİLEREK YOK: Spotify 30 saniyelik önizleme adresini de
/// Kasım 2024'te yeni uygulamalara kapattı. Ses yalnızca gömülü player'dan
/// (`open.spotify.com/embed`) gelir — o mekanizma Web API'den ayrı ve bu
/// kapanmalardan etkilenmiyor.
model MusicTrack {
  id    String @id @default(cuid())
  slug  String @unique
  title String

  discNumber  Int @default(1)
  trackNumber Int @default(0)

  durationMs Int?
  isExplicit Boolean @default(false)
  popularity Int?

  spotifyId String? @unique

  externalData          Json?
  externalDataFetchedAt DateTime?

  albumId String
  album   MusicAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  credits         MusicTrackCredit[]
  externalRefs    MusicExternalRef[]
  playlistEntries MusicPlaylistTrack[]
  plays           MusicPlay[]

  /// Parça listesinin tek sorgusu: disk, sonra sıra
  @@index([albumId, discNumber, trackNumber])
  @@index([isDeleted])
}

/// Parça künyesi: parça ↔ (kişi VEYA act), rol ile.
///
/// ⚠️ "personId ve actId'den tam olarak biri dolu" kuralı Prisma'da ifade
/// EDİLEMEZ; servis katmanında doğrulanır. Bu, `Comment`/`Favorite`
/// modellerindeki nullable-FK deseninin bilinen bedeli — polimorfik bir
/// `entityType` sütunu yerine gerçek FK'leri seçmenin karşılığı (cascade ve
/// index çalışıyor, tip güvenliği duruyor).
model MusicTrackCredit {
  id String @id @default(cuid())

  trackId String
  track   MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  roleId  String
  role    MusicRole  @relation(fields: [roleId], references: [id])

  personId String?
  person   MusicPerson? @relation(fields: [personId], references: [id], onDelete: Cascade)
  actId    String?
  act      MusicalAct?  @relation(fields: [actId], references: [id], onDelete: Cascade)

  orderIndex Int @default(0)

  @@index([trackId, orderIndex])
  // Kural 14
  @@index([personId])
  @@index([actId])
  @@index([roleId])
}

/// Tür / alt tür.
///
/// `BookGenre`ın kardeşi ve aynı gerekçeyle: **kaynaktan gelen tür otomatik
/// kabul edilmez.** Spotify'ın `genres` alanı toplulukta tutarsız/eksik
/// raporlanıyor; otomatik kabul edilse liste aynı kavramın varyantlarıyla
/// dolardı. Eşleşmeyen tür `isApproved: false` ile açılır, süzgeçte görünmez
/// ve admin panelde onay bekler.
///
/// `BookGenre`da olmayan tek ekleme: `parentId` — tür/alt tür hiyerarşisi.
model MusicGenre {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// Ön yüzdeki sabit tür listesinin i18n anahtarı; kaynaktan gelip listede
  /// karşılığı olmayan türde boş kalır.
  key String? @unique

  /// Tür odasının kendi accent'i (tasarım 2b: rock bordo, pop pembe,
  /// elektronik teal). Burada **renk değeri DEĞİL token anahtarı** durur
  /// ("rock", "pop", "electronic"); gerçek renk `globals.css` içindeki
  /// `[data-genre="rock"]` bloğunda tanımlı. Kural 16: bileşen hex okumaz,
  /// veritabanı da hex taşımaz — yoksa tema değiştiğinde oda rengi
  /// veritabanından gelen sabit bir değerle çakışırdı.
  accentKey String?

  parentId String?
  parent   MusicGenre?  @relation("MusicGenreTree", fields: [parentId], references: [id])
  children MusicGenre[] @relation("MusicGenreTree")

  isApproved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acts MusicGenreOnAct[]
  /// Bu odada görünen çalma listeleri — bkz. `MusicPlaylist.genreId`
  playlists MusicPlaylist[]

  @@index([isApproved])
  // Kural 14
  @@index([parentId])
}

model MusicGenreOnAct {
  actId   String
  act     MusicalAct @relation(fields: [actId], references: [id], onDelete: Cascade)
  genreId String
  genre   MusicGenre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([actId, genreId])
  @@index([genreId])
}

/// Act'in KENDİ tarihindeki dönem — nesnel bilgi ("Hybrid Theory dönemi").
///
/// ⚠️ Faz 2'de gelecek `MusicPersonalEra` ile HİÇBİR ilişkisi yok ve hiçbir
/// sorguda birleştirilmez: bu `actId`ye bağlıdır (bandın tarihi), o
/// `userId`ye (senin tarihin, "2000-2007 dönemim"). İkisini tek tabloda
/// birleştirme önerisi gelirse reddedilir.
///
/// Faz 1 migration'ına alınma sebebi: `MusicAlbum.eraId` FK'sinin hedefi.
/// Tabloyu sonraya bırakmak Faz 3'te `MusicAlbum`a ALTER gerektirirdi.
model MusicEra {
  id   String @id @default(cuid())
  slug String @unique
  name String

  startedAt   DateTime?
  endedAt     DateTime?
  description String?   @db.Text
  orderIndex  Int       @default(0)

  actId String
  act   MusicalAct @relation(fields: [actId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  albums MusicAlbum[]

  @@index([actId, orderIndex])
}

/// İkincil dış kaynak bağları (MusicBrainz, Discogs…).
///
/// ⚠️ Planın önerdiği saf polimorfik `ExternalRef(entityType, entityId)`
/// KULLANILMADI: o biçimde gerçek FK kurulamaz, `onDelete: Cascade`
/// çalışmaz, kayıt silinince yetim satır kalır ve her okuma elle join olur.
/// Bunun yerine `Comment`/`Favorite` deseni — dört nullable GERÇEK FK.
///
/// Birincil kaynak (Spotify) kimliği burada DEĞİL, entity'nin kendi
/// `spotifyId` sütununda: projenin mevcut deseni bu (`BookEntry.googleId`,
/// `AnimePart.malId`) ve günlük sorgular join'siz okusun diye.
///
/// `entityKind` sütunu, `provider + externalId` çiftinin tek başına yeterli
/// olmadığı için var: Discogs'ta artist 123 ile release 123 ayrı uzaylarda
/// ama aynı dizeyi taşıyabiliyor.
model MusicExternalRef {
  id String @id @default(cuid())

  provider   MusicProvider
  entityKind MusicEntityKind
  externalId String
  url        String?
  lastSyncedAt DateTime?

  personId String?
  person   MusicPerson? @relation(fields: [personId], references: [id], onDelete: Cascade)
  actId    String?
  act      MusicalAct?  @relation(fields: [actId], references: [id], onDelete: Cascade)
  albumId  String?
  album    MusicAlbum?  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  trackId  String?
  track    MusicTrack?  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, entityKind, externalId])
  // Kural 14
  @@index([personId])
  @@index([actId])
  @@index([albumId])
  @@index([trackId])
}

/// Senkronizasyon defteri — **Redis/Bull yerine.**
///
/// Plan Bull öneriyordu ama o desen başka bir projeden (ultnexus) geliyor:
/// bu repoda Redis servisi, `bull`/`ioredis` bağımlılığı YOK ve mevcut iki
/// sync (`anime/anime.cron.ts`, `football.service.ts`) `@nestjs/schedule` +
/// yeniden girişi engelleyen bir `running` bayrağıyla çalışıyor.
///
/// Bull'un buradaki tek gerçek üstünlüğü kalıcı kuyruk ve retry sayacıydı;
/// ikisi de bu tabloda var. Üstelik kuyruk veritabanında olduğu için
/// `pg_dump` yedeğine giriyor (kural 15) — Redis girmezdi.
model MusicSyncState {
  id String @id @default(cuid())

  entityKind MusicEntityKind
  /// Kendi kayıt kimliğimiz (FK değil: kayıt silinse de defter satırı
  /// hata geçmişi olarak durabilir)
  entityId   String

  status   MusicSyncStatus @default(PENDING)
  attempts Int             @default(0)
  /// Son hatanın mesajı — admin panelde görünür. Kural 6: kullanıcıya temiz
  /// mesaj, deftere ayrıntı.
  lastError String?
  lastRunAt DateTime?
  /// Sıradaki denemenin en erken zamanı (basit geri çekilme)
  nextRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityKind, entityId])
  /// Cron'un tek sorgusu: sırası gelmiş bekleyen işler
  @@index([status, nextRunAt])
}

/// Çalma listesi (tasarım 2a "Favori Listelerim", 2b "Odanın çalma listesi").
///
/// Kullanıcı kararı (11 Ağustos 2026): listeler Spotify'da **herkese açık**,
/// yani Client Credentials ile Faz 1'de okunabiliyor — kullanıcı girişi
/// gerekmiyor.
///
/// ⚠️ Spotify'ın KENDİ editoryal/algoritmik listeleri (Discover Weekly,
/// Today's Top Hits) yeni uygulamalara kapalı; burada yalnızca kullanıcının
/// kendi oluşturduğu listeler tutulur.
///
/// Tür karışımı (tasarımdaki yüzdeli çubuk) **saklanmaz, türetilir**:
/// parça → albüm → act → tür zinciri zaten şemada var. Yüzdeyi sütuna
/// yazmak, tür onayı değiştiğinde (bkz. `MusicGenre.isApproved`) yanlış
/// kalacak ikinci bir gerçek üretirdi.
model MusicPlaylist {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  description String? @db.Text

  /// Kaynağın verdiği toplamlar; parça listesi eksik senkronize olsa da
  /// künyedeki "64 parça · 4 sa 12 dk" doğru kalsın diye ayrıca tutuluyor.
  trackCount Int?
  durationMs Int?

  artwork          String?
  artworkSourceUrl String?
  artworkFetchedAt DateTime?

  /// Küratör sıralaması — "favori listelerim" şeridinin sırası
  orderIndex Int     @default(0)
  isFavorite Boolean @default(false)

  /// Listenin ODASI — hangi tür odasının altında görünecek.
  ///
  /// ⚠️ Kararı KÜRATÖR veriyor, içerikten türetilMİYOR (kullanıcı isteği,
  /// 13 Ağustos 2026: *"bu ürettiğim listenin hangi tür altında yer alacağına
  /// ben karar vereyim"*). Parçaların türlerinden çoğunluk hesaplamak
  /// mümkündü ama "yarısı rock yarısı pop" bir listede sonuç keyfî olurdu ve
  /// küratörün niyetini ezerdi.
  ///
  /// `MusicGenreOnAct` gibi çoka-çok DEĞİL, tek FK: bir liste kavramsal
  /// olarak tek bir odaya ait ("rock listem"). İki odada birden görünmesi
  /// istenirse ikinci bir liste kurmak daha dürüst — aynı listeyi iki yerde
  /// göstermek "hangisi asıl" sorusunu doğururdu.
  ///
  /// `onDelete: SetNull`: tür silinirse liste ODASIZ kalır, SİLİNMEZ.
  /// Cascade olsaydı bir tür temizliği kullanıcının kendi listelerini
  /// götürürdü — kişisel katman katalog işlemlerinden etkilenmemeli.
  genreId String?
  genre   MusicGenre? @relation(fields: [genreId], references: [id], onDelete: SetNull)

  spotifyId String? @unique

  externalData          Json?
  externalDataFetchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  tracks MusicPlaylistTrack[]

  @@index([isDeleted, isFavorite, orderIndex])
  /// Tür odasının "bu odadaki listeler" sorgusu — kural 14
  @@index([genreId])
}

model MusicPlaylistTrack {
  playlistId String
  playlist   MusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  track      MusicTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  /// Listedeki sıra
  position Int @default(0)
  /// Listeye eklenme zamanı (Spotify veriyor)
  addedAt  DateTime?

  @@id([playlistId, trackId])
  @@index([playlistId, position])
  @@index([trackId])
}

/// Tek bir dinleme olayı — dinleme kaydı ekranının (tasarım 2d) tek kaynağı.
///
/// ── NEDEN BÖYLE BİR TABLO GEREKİYOR ──────────────────────────────────────
/// Spotify Web API'sinde **çalma sayısı ucu YOKTUR.** Tasarımdaki "1.842
/// dinleme", "61s 24d dinleme süresi", "en yoğun gün: Cuma", "%23 yeni
/// keşif" hiçbir istekle gelmiyor. Gelen iki şey var ve ikisi de yetersiz:
///   /me/top/artists|tracks      → SIRALAMA verir, sayı vermez
///   /me/player/recently-played  → yalnızca son 50 kayıt, geçmiş yok
/// Yani sayılar ancak bizim biriktirdiğimiz bir kayıttan çıkar. Bu tablo o.
///
/// ── İKİ KAYNAK (kullanıcı kararı, 11 Ağustos 2026) ───────────────────────
/// 1. IMPORT — Spotify hesap ayarlarından istenen "Extended streaming
///    history" JSON dosyaları. Tüm zamanları kapsıyor; bir kez içe
///    aktarılınca 2d ilk günden gerçek sayılarla dolu olur.
/// 2. RECENTLY_PLAYED — Faz 5'te periyodik yoklama; içe aktarımdan sonrasını
///    güncel tutar.
///
/// ── NEDEN AD ALANLARI DA DURUYOR ─────────────────────────────────────────
/// `trackId` opsiyonel: dinlediğim her parça arşivde olmak zorunda değil.
/// `F1RaceResult.driverName` ile birebir aynı gerekçe — kayıt açılmamışken de
/// satır yazılabilsin. İlişki doluysa O önceliklidir; sayımlar isim üstünden
/// de çalışır.
///
/// ⚠️ BU TABLO KİŞİSEL VERİDİR. Katalog sync'i (act/album/track tazeleme)
/// buraya **asla** yazmaz ve buradan asla silmez; yalnızca içe aktarım ve
/// yoklama yolu yazar. Şemanın en üstündeki yazma-izni kuralı bu tabloyu da
/// kapsar.
model MusicPlay {
  id String @id @default(cuid())

  /// Kural 6/12: arşiv kişisel ama şema çok kullanıcıya hazır
  userId String

  playedAt DateTime
  /// Kaç milisaniye çalındı — "dinleme süresi" toplamı bundan çıkıyor.
  /// Kısa atlamaları saymamak için eşik servis katmanında (30 sn).
  msPlayed Int?

  /// Kaynağın parça anahtarı ("spotify:track:…"). Eşleştirmenin ve tekrar
  /// korumasının dayanağı; içe aktarım dosyası bunu veriyor.
  spotifyTrackUri String?

  /// Düz metin künye — arşivde karşılığı olmayan dinlemeler için
  trackName  String
  artistName String?
  albumName  String?

  source MusicPlaySource @default(IMPORT)

  trackId String?
  track   MusicTrack? @relation(fields: [trackId], references: [id])

  createdAt DateTime @default(now())

  /// Aynı dinleme iki kez girmesin: içe aktarım ve yoklama aynı aralığı
  /// kapsayabilir. `playedAt` milisaniye hassasiyetinde geliyor, parça
  /// anahtarıyla birlikte tekrar koruması güvenli.
  @@unique([userId, playedAt, spotifyTrackUri])
  /// 2d'nin tek sorgusu: dönem aralığı, tersten
  @@index([userId, playedAt])
  /// "En çok dinlenen sanatçılar" ve "odaların payı" isim üstünden gruplanıyor
  @@index([userId, artistName])
  // Kural 14
  @@index([trackId])
}

enum MusicPlaySource {
  /// "Extended streaming history" dosyasından içe aktarıldı (tüm zamanlar)
  IMPORT
  /// /me/player/recently-played yoklamasından geldi (Faz 5)
  RECENTLY_PLAYED
}

enum MusicActKind {
  /// Sync'ten gelen act'ler burada başlar; sınıflandırma küratörün işi
  UNCLASSIFIED
  BAND
  SOLO_PROJECT
  DUO
  GROUP
  ORCHESTRA
}

enum MusicAlbumType {
  ALBUM
  SINGLE
  EP
  COMPILATION
  LIVE
  SOUNDTRACK
}

enum MusicProvider {
  SPOTIFY
  MUSICBRAINZ
  DISCOGS
  WIKIDATA
  LASTFM
}

enum MusicEntityKind {
  PERSON
  ACT
  ALBUM
  TRACK
}

enum MusicSyncStatus {
  PENDING
  RUNNING
  OK
  FAILED
}

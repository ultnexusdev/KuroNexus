DATABASE_URL="postgresql://user:password@localhost:5432/kuronexus?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Admin seed (prisma db seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"

# Server
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES=10485760

# API-Sports (API-Football)
FOOTBALL_API_KEY=your-api-sports-key
FOOTBALL_API_HOST=v3.football.api-sports.io
FOOTBALL_TEAM_ID=496
FOOTBALL_SEASON=2024

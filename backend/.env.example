DATABASE_URL="postgresql://user:password@localhost:5432/kuronexus?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Admin seed (prisma db seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"

# Server
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES=10485760

# Transfermarkt Local Data Sync
TM_TEAM_ID=141
TM_SEASON=2024

# Kaggle API (transfermarkt-datasets indirmesi icin)
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key
KAGGLE_API_TOKEN=your-kaggle-access-token
